#!/bin/bash

set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
version=$(<"$root/VERSION")
install_root="$HOME/.local/share/agent-workspaces-app/$version"
backup_root="$HOME/.local/share/agent-workspaces-app/backups/$(date +%Y%m%d-%H%M%S)"
config_root="${XDG_CONFIG_HOME:-$HOME/.config}/agent-workspaces"
menu_file="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/extensions/omarchy-menu.jsonc"
bin_root="$HOME/.local/bin"
systemd_root="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

mkdir -p "$backup_root" "$config_root/providers" "$bin_root" "$systemd_root"
if [[ -d $install_root ]]; then
  mv "$install_root" "$backup_root/install-root"
fi
mkdir -p "$install_root"
legacy_prompt="$bin_root/omarchy-agent-prompt"
if [[ -e $legacy_prompt || -L $legacy_prompt ]]; then
  mv "$legacy_prompt" "$backup_root/omarchy-agent-prompt.agent-workspaces-legacy"
fi
[[ -d $config_root ]] && cp -a "$config_root" "$backup_root/config-root"
managed_bins=("$bin_root/agent-workspaces")
for source_file in "$root/compat/bin"/*; do managed_bins+=("$bin_root/$(basename "$source_file")"); done
for target in "${managed_bins[@]}" "$config_root/config.json" "$menu_file"; do
  [[ -e $target || -L $target ]] || continue
  cp -a "$target" "$backup_root/$(basename "$target")"
done
mkdir -p "$(dirname "$menu_file")"

cp -a "$root/bin" "$root/lib" "$root/schemas" "$root/packaging" "$install_root/"
cp -a "$root/compat" "$install_root/"
cp "$root/VERSION" "$root/README.md" "$install_root/"
cp "$root/config/providers"/*.json "$config_root/providers/"
mkdir -p "$config_root/instructions" "$config_root/templates"
cp "$root/config/protocol.md" "$config_root/protocol.md"
cp "$root/config/instructions"/*.md "$config_root/instructions/"
cp "$root/config/templates"/* "$config_root/templates/"
if [[ ! -f $config_root/config.json ]]; then
  cp "$root/config/config.json" "$config_root/config.json"
else
  temporary=$(mktemp "$config_root/.config.json.XXXXXX")
  jq -s '.[0] * .[1]' "$root/config/config.json" "$config_root/config.json" >"$temporary"
  mv "$temporary" "$config_root/config.json"
fi

ln -sfn "$install_root/bin/agent-workspaces" "$bin_root/agent-workspaces"
for source_file in "$install_root/compat/bin"/*; do
  target="$bin_root/$(basename "$source_file")"
  cp "$source_file" "$target"
  chmod +x "$target"
done
for source_file in "$install_root/compat/portable"/*; do
  target="$bin_root/$(basename "$source_file")"
  cp "$source_file" "$target"
  chmod +x "$target"
done
for source_file in "$install_root/compat/systemd"/*; do
  cp "$source_file" "$systemd_root/$(basename "$source_file")"
done
cp "$install_root/compat/omarchy/omarchy-menu.jsonc" "$menu_file"
chmod +x "$install_root/bin/agent-workspaces" "$install_root/packaging/migrate" "$install_root/packaging/rollback"
printf '%s\n' "$version" >"$HOME/.local/share/agent-workspaces-app/current-version"
printf '%s\n' "$backup_root" >"$HOME/.local/share/agent-workspaces-app/last-backup"
"$bin_root/agent-workspaces" migrate
"$bin_root/agent-workspaces" doctor
systemctl --user daemon-reload
systemctl --user enable --now agent-workspaces-usage.timer
systemctl --user start agent-workspaces-usage.service
printf 'Installed Agent Workspaces %s. Rollback bundle: %s\n' "$version" "$backup_root"
