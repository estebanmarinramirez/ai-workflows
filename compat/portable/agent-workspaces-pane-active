#!/bin/bash
set -euo pipefail
provider=${1:?provider required}
session=${2:?tmux session required}
tmux has-session -t "$session" 2>/dev/null || exit 1
pane_pid=$(tmux list-panes -t "$session" -F '#{pane_pid}' | head -1)
[[ -n $pane_pid ]] || exit 1
pattern=$(jq -r '.process_pattern // empty' "$HOME/.config/agent-workspaces/providers/$provider.json" 2>/dev/null)
[[ -n $pattern ]] || pattern=$provider
pgrep -P "$pane_pid" -a 2>/dev/null | grep -Eq -- "$pattern|$provider"
