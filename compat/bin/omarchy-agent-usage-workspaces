#!/usr/bin/python3
"""Emit lifecycle-aware workspace health for Omarchy's native Agents panel."""

import json
import os
from datetime import datetime, timedelta
from pathlib import Path


TERMINAL = {"completed", "draft_pr", "ready_for_pr", "cancelled", "archived", "superseded"}
REVIEW = {"awaiting_review", "awaiting_triage", "awaiting_integration", "awaiting_pr", "awaiting_pr_review"}


def timestamp(value):
    if not value:
        return None
    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00"))
    except ValueError:
        return None


def completion_time(task):
    for transition in reversed(task.get("transitions") or []):
        if transition.get("to") in TERMINAL:
            return timestamp(transition.get("at"))
    return timestamp(task.get("updated_at")) if task.get("status") in TERMINAL else None


home = Path.home()
data_root = Path(os.environ.get("XDG_DATA_HOME", home / ".local/share")) / "agent-workspaces"
now = datetime.now().astimezone()
week_start = now - timedelta(days=7)
today = now.date()
workspaces = []
all_tasks = []
current_tasks = []
completed_week = 0
completed_today = 0
launch_days = set()

for workspace_file in data_root.rglob("workspace.json") if data_root.is_dir() else []:
    if workspace_file.parent.parent.parent != data_root:
        continue
    workspaces.append(workspace_file)
    tasks = []
    for state_file in (workspace_file.parent / ".coordination").glob("*/state.json"):
        try:
            task = json.loads(state_file.read_text())
        except (OSError, ValueError):
            continue
        task["_created"] = timestamp(task.get("created_at"))
        tasks.append(task)
        all_tasks.append(task)
        if task["_created"]:
            launch_days.add(task["_created"].date())
        finished = completion_time(task)
        if finished and finished >= week_start:
            completed_week += 1
            if finished.date() == today:
                completed_today += 1
    # Older open records are historical/superseded coordination state. Only
    # the newest task in a workspace represents its current delivery flow.
    if tasks:
        latest = max(tasks, key=lambda task: task["_created"] or datetime.min.replace(tzinfo=now.tzinfo))
        if latest.get("status") not in TERMINAL:
            current_tasks.append(latest)

blocked = sum(task.get("status") == "blocked" for task in current_tasks)
review = sum(task.get("status") in REVIEW for task in current_tasks)
running = len(current_tasks)
usage_root = Path(os.environ.get("XDG_STATE_HOME", home / ".local/state")) / "omarchy/agents/usage"
participating_providers = set()
for task in current_tasks:
    participating_providers.update((task.get("roles") or {}).keys())

provider_usage = []
provider_resets = []
for provider in sorted(participating_providers):
    try:
        provider_record = json.loads((usage_root / f"{provider}.json").read_text())
    except (OSError, ValueError, AttributeError):
        continue
    percentages = []
    for limit in provider_record.get("limits") or []:
        try:
            percentages.append(max(0.0, min(1.0, float(limit.get("percent")))))
            if limit.get("resetsAt"):
                provider_resets.append(limit["resetsAt"])
        except (TypeError, ValueError, AttributeError):
            continue
    if percentages:
        # A provider is only as available as its most constrained active limit.
        provider_usage.append(max(percentages))

status_parts = [f"{running} running"]
if review:
    status_parts.append(f"{review} review")
if blocked:
    status_parts.append(f"{blocked} blocked")
status_parts.append(f"{completed_week} done/7d")
limits = []
if provider_usage:
    pooled_usage = sum(provider_usage) / len(provider_usage)
    limits.append({
        "label": f"Pooled usage across {len(provider_usage)} providers",
        "title": "Pooled model quota",
        "percent": pooled_usage,
        "resetsAt": min(provider_resets) if provider_resets else "",
    })

record = {
    "schemaVersion": 1,
    "id": "agent-workspaces",
    "name": "Workspaces",
    "ready": True,
    "tierLabel": " · ".join(status_parts),
    "usageStatusText": "Attention required" if blocked else "",
    "authHelpText": f"{blocked} blocked" if blocked else "",
    "limits": limits,
    "todayPrompts": completed_today,
    "todaySessions": running,
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [],
    "totalPrompts": len(all_tasks),
    "totalSessions": len(workspaces),
    "activeDays": len(launch_days),
    "activeDates": sorted(day.isoformat() for day in launch_days),
    "modelUsage": {},
    "hasLocalStats": True,
    "hasPromptStats": False,
    "updatedAt": now.isoformat(),
}
print(json.dumps(record, separators=(",", ":")))
