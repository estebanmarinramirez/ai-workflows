#!/bin/bash

# Refresh Agent Workspaces' additional records for Omarchy's native Agents panel.
set -uo pipefail

resolve_usage_lib() {
  if [[ -n ${AW_USAGE_LIB:-} ]]; then
    printf '%s\n' "$AW_USAGE_LIB"
    return
  fi
  local development installed
  development=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/lib/usage.sh
  [[ -f $development ]] && { printf '%s\n' "$development"; return; }
  installed=$(readlink -f "$HOME/.local/bin/agent-workspaces" 2>/dev/null || true)
  [[ -n $installed ]] && printf '%s/lib/usage.sh\n' "$(dirname "$(dirname "$installed")")"
}

usage_lib=$(resolve_usage_lib)
if [[ ! -f $usage_lib ]]; then
  printf 'agent-workspaces: usage runtime not found\n' >&2
  exit 1
fi
source "$usage_lib"

usage_dir="$(aw_usage_state_root)/usage"
mkdir -p "$usage_dir"
status=0
# Budget admission must not depend on the desktop panel being open. Native
# collectors query account limits only here; they do not generate model turns.
config_file="${XDG_CONFIG_HOME:-$HOME/.config}/agent-workspaces/config.json"
if jq -e '.budget.enabled == true' "$config_file" >/dev/null 2>&1 && command -v omarchy >/dev/null 2>&1; then
  if ! omarchy agent usage-update --limits-only codex claude; then
    aw_usage_log ERROR quota 'native quota refresh failed; budget admission stays conservative'
    status=1
  fi
  python3 "$(dirname "$usage_lib")/codex_quota.py" || status=1
fi
collectors=${AW_USAGE_COLLECTORS:-grok=$HOME/.local/bin/omarchy-agent-usage-grok:agent-workspaces=$HOME/.local/bin/omarchy-agent-usage-workspaces}
IFS=: read -r -a entries <<<"$collectors"
for entry in "${entries[@]}"; do
  id=${entry%%=*}
  collector=${entry#*=}
  if [[ -z $id || $collector == "$entry" ]]; then
    aw_usage_log ERROR registry "invalid collector entry: $entry"
    status=1
    continue
  fi
  aw_usage_refresh_collector "$id" "$collector" "$usage_dir" || status=1
done
# Durable observations include inactive workspaces and existing audit history.
if ! python3 "$(dirname "$usage_lib")/telemetry.py" collect >/dev/null; then
  aw_usage_log ERROR telemetry "collection incomplete; inspect agent-workspaces telemetry status"
  status=1
fi
exit "$status"
