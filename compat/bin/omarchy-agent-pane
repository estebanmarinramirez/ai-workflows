#!/bin/bash

role=${1:?role required}
session=${2:?tmux session required}
directory=${3:?working directory required}
description=${4:-${role^}}
state_file=${5:-}
repository=${6:-}
set_slug=${7:-}
class_prefix=${8:-}
workspace_id=${9:-}
profile=${AW_PERMISSION_PROFILE:-trusted}
provider=${AW_AGENT_PROVIDER:-$role}
configured_orchestrator=$(jq -r '.orchestrator_provider // "codex"' "$HOME/.config/agent-workspaces/config.json")
if [[ $role == orchestrator ]]; then
  provider=$configured_orchestrator
  if ! agent-workspaces available-providers | grep -qx "$provider"; then
    provider=$(agent-workspaces available-providers | head -1)
  fi
  [[ -n $provider ]] || { printf 'No enabled provider is installed.\n' >&2; exit 1; }
fi
[[ $role == orchestrator ]] && profile=$(jq -r '.orchestrator_profile // "trusted"' "$HOME/.config/agent-workspaces/config.json")
orchestrator_model=$(jq -r '.orchestrator_model // empty' "$HOME/.config/agent-workspaces/config.json")
[[ $provider == "$configured_orchestrator" ]] || orchestrator_model=''
worker_env=''
if [[ $role != orchestrator && $role != integration ]] && command -v sccache >/dev/null 2>&1; then
  cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/sccache"
  worker_env="env RUSTC_WRAPPER=sccache SCCACHE_DIR=$(printf %q "$cache_dir")"
fi

set_session_metadata() {
  tmux set-option -q -t "$session" @description "$description"
  [[ -n $repository ]] && tmux set-option -q -t "$session" @aw_repository "$repository"
  [[ -n $set_slug ]] && tmux set-option -q -t "$session" @aw_set "$set_slug"
  [[ -n $class_prefix ]] && tmux set-option -q -t "$session" @aw_class_prefix "$class_prefix"
  [[ -n $workspace_id ]] && tmux set-option -q -t "$session" @aw_workspace_id "$workspace_id"
  tmux set-option -q -t "$session" @aw_role "$role"
  tmux set-option -q -t "$session" @aw_provider "$provider"
  tmux set-option -q -t "$session" @aw_profile "$profile"
}

was_started=false
if [[ -n $state_file ]]; then
  [[ -f $state_file ]] && was_started=true
  mkdir -p "$(dirname "$state_file")"
  touch "$state_file"
fi

case "$role" in
  orchestrator)
    monitor="agent-workspaces monitor-start $(printf %q "$workspace_id") >/dev/null 2>&1;"
    coordination_dir=${directory%/.orchestrator}/.coordination
    welcome="Read snapshot.md, introduce yourself as this workspace's Orchestrator, summarize the active workflow in a few lines, and ask what the user wants to coordinate."
    directory_access=''
    remote_control=''
    [[ $provider == codex || $provider == claude ]] && directory_access="--add-dir $(printf %q "$coordination_dir")"
    [[ $provider == claude ]] && remote_control="--remote-control $(printf %q "Workspaces · $set_slug")"
    fresh="$monitor AW_WORKSPACE_ID=$(printf %q "$workspace_id") $(agent-workspaces provider-command "$provider" fresh "$profile" '' "$orchestrator_model") $remote_control $directory_access $(printf %q "$welcome")"
    provider_session_id=$(tmux show-option -qv -t "$session" @aw_provider_session_id 2>/dev/null)
    resume="$monitor AW_WORKSPACE_ID=$(printf %q "$workspace_id") $(agent-workspaces provider-command "$provider" resume "$profile" "$provider_session_id" "$orchestrator_model") $remote_control $directory_access"
    ;;
  integration) launch='' ;;
  *)
    fresh="$worker_env $(agent-workspaces provider-command "$provider" fresh "$profile")"
    provider_session_id=$(tmux show-option -qv -t "$session" @aw_provider_session_id 2>/dev/null)
    resume="$worker_env $(agent-workspaces provider-command "$provider" resume "$profile" "$provider_session_id")"
    ;;
esac

if tmux has-session -t "$session" 2>/dev/null; then
  set_session_metadata
  if [[ $role != integration ]]; then
    pane=$(tmux list-panes -t "$session" -F '#{pane_id}' | head -1)
    if ! omarchy-agent-pane-active "$provider" "$session"; then
      relaunch=$fresh
      [[ $was_started == true ]] && relaunch="$resume || $fresh"
      tmux send-keys -t "$pane" -l -- "$relaunch"
      tmux send-keys -t "$pane" Enter
    fi
  fi
  exec tmux attach-session -t "$session"
fi

if [[ $role != integration ]]; then
  launch=$fresh
  if [[ $was_started == true ]]; then
    # A missing tmux session means the machine or tmux server stopped. Resume
    # the newest conversation scoped to this worktree; fall back to a fresh
    # conversation only when the agent reports that nothing can be resumed.
    launch="$resume || $fresh"
  fi
  # Keep an interactive shell in the pane if the agent exits, so the tmux
  # session remains available for review and manual relaunching.
  post_launch="$launch; agent-workspaces remember-session $(printf %q "$session") $(printf %q "$provider") $(printf %q "$directory") >/dev/null 2>&1 || true; exec bash"
  tmux new-session -d -s "$session" -c "$directory" bash -lc "$post_launch"
else
  tmux new-session -d -s "$session" -c "$directory"
fi
set_session_metadata
exec tmux attach-session -t "$session"
