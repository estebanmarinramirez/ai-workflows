#!/usr/bin/python3
"""Emit Omarchy's native Agents usage contract from local Grok sessions."""

import json
import os
from collections import defaultdict
from datetime import datetime, timedelta
from pathlib import Path


def number(value):
    try:
        return int(value or 0)
    except (TypeError, ValueError):
        return 0


def local_day(timestamp):
    try:
        return datetime.fromtimestamp(float(timestamp)).astimezone().strftime("%Y-%m-%d")
    except (TypeError, ValueError, OSError):
        return datetime.now().strftime("%Y-%m-%d")


def latest_subscription(log_path):
    """Read the newest billing snapshot without parsing an unbounded log."""
    try:
        with log_path.open("rb") as stream:
            stream.seek(0, os.SEEK_END)
            size = stream.tell()
            start = max(0, size - 8 * 1024 * 1024)
            stream.seek(start)
            data = stream.read()
    except OSError:
        return None
    if start:
        data = data.split(b"\n", 1)[-1]
    for raw in reversed(data.splitlines()):
        try:
            event = json.loads(raw)
            context = event.get("ctx") or {}
            config = context.get("config") or {}
            used = config.get("creditUsagePercent")
            if used is None:
                continue
            period = config.get("currentPeriod") or {}
            return {
                "tier": context.get("subscriptionTier") or "Subscription",
                "used": max(0.0, min(100.0, float(used))),
                "reset": period.get("end") or config.get("billingPeriodEnd") or "",
            }
        except (ValueError, TypeError, AttributeError):
            continue
    return None


home = Path.home()
grok_root = Path(os.environ.get("GROK_HOME", home / ".grok"))
session_root = grok_root / "sessions"
now = datetime.now().astimezone()
today = now.strftime("%Y-%m-%d")
recent_dates = [(now - timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]
daily = defaultdict(int)
models = defaultdict(lambda: {"inputTokens": 0, "outputTokens": 0, "cacheReadInputTokens": 0, "cacheCreationInputTokens": 0})
today_models = defaultdict(int)
active_dates = set()
today_session_ids = set()
sessions = 0
turns = 0
today_turns = 0

if session_root.is_dir():
    for updates in session_root.rglob("updates.jsonl"):
        previous = {"inputTokens": 0, "outputTokens": 0, "cachedReadTokens": 0, "cacheCreationTokens": 0}
        saw_usage = False
        try:
            lines = updates.open(encoding="utf-8", errors="replace")
        except OSError:
            continue
        with lines:
            for raw in lines:
                try:
                    event = json.loads(raw)
                    update = event.get("params", {}).get("update", {})
                    if update.get("sessionUpdate") != "turn_completed":
                        continue
                    usage = update.get("usage") or {}
                    if not usage:
                        continue
                except (ValueError, AttributeError):
                    continue
                saw_usage = True
                day = local_day(event.get("timestamp"))
                active_dates.add(day)
                if day == today:
                    today_session_ids.add(str(updates.parent))
                turns += 1
                if day == today:
                    today_turns += 1
                current = {key: number(usage.get(key)) for key in previous}
                delta = {key: max(0, current[key] - previous[key]) for key in previous}
                previous = current
                model_usage = usage.get("modelUsage") or {}
                model = next(iter(model_usage), "grok")
                input_tokens = delta["inputTokens"]
                output_tokens = delta["outputTokens"]
                cache_read = delta["cachedReadTokens"]
                cache_write = delta["cacheCreationTokens"]
                total = input_tokens + output_tokens + cache_read + cache_write
                daily[day] += total
                bucket = models[model]
                bucket["inputTokens"] += input_tokens
                bucket["outputTokens"] += output_tokens
                bucket["cacheReadInputTokens"] += cache_read
                bucket["cacheCreationInputTokens"] += cache_write
                if day == today:
                    today_models[model] += total
        if saw_usage:
            sessions += 1

config_path = Path(os.environ.get("XDG_CONFIG_HOME", home / ".config")) / "agent-workspaces" / "config.json"
plan = "Subscription"
try:
    plan = json.loads(config_path.read_text()).get("model_policy", {}).get("grok", {}).get("plan") or plan
except (OSError, ValueError, AttributeError):
    pass
subscription = latest_subscription(grok_root / "logs" / "unified.jsonl")
if subscription:
    plan = subscription["tier"]
limits = []
if subscription:
    limits.append({
        "label": "Weekly subscription pool",
        "title": "Weekly pool",
        "percent": subscription["used"] / 100.0,
        "resetsAt": subscription["reset"],
    })
ready = sessions > 0 or subscription is not None
record = {
    "schemaVersion": 1,
    "id": "grok",
    "name": "Grok",
    "ready": ready,
    "tierLabel": f"{plan} · Grok 4.6 · high",
    "usageStatusText": "" if ready else "Authentication needed",
    "authHelpText": "" if ready else "Run `grok` and sign in to begin recording usage.",
    "limits": limits,
    "todayPrompts": today_turns,
    "todaySessions": len(today_session_ids),
    "todayTotalTokens": daily[today],
    "todayTokensByModel": dict(today_models),
    "recentDays": [{"date": day, "messageCount": daily[day]} for day in recent_dates],
    "totalPrompts": turns,
    "totalSessions": sessions,
    "activeDays": len(active_dates),
    "activeDates": sorted(active_dates),
    "modelUsage": dict(models),
    "hasLocalStats": True,
    "updatedAt": now.isoformat(),
}
print(json.dumps(record, separators=(",", ":")))
