#!/bin/bash

# Workflow-specific prompt dispatcher. Deliberately does not use Omarchy's
# reserved omarchy-agent-prompt command name.

set -o pipefail

# CLI callers must receive a diagnostic even without a desktop notification daemon.
dispatch_error() {
  printf 'agent-workspaces dispatch: %s\n' "$1" >&2
  notify-send 'Agent Dispatcher' "$1" 2>/dev/null || true
}

declare -A workspace_labels=()
declare -A workspace_sessions=()
declare -A workspace_repositories=()
declare -A workspace_sets=()

while IFS=$'\t' read -r session workspace_id role repository set_slug; do
  [[ -n $workspace_id && $role != integration && $role != orchestrator ]] || continue
  workspace_labels["$workspace_id"]="$set_slug · $(basename "$repository")"
  workspace_sessions["$workspace_id"]+="${workspace_sessions[$workspace_id]:+$'\n'}$session"
  workspace_repositories["$workspace_id"]=$repository
  workspace_sets["$workspace_id"]=$set_slug
done < <(tmux list-sessions -F $'#{session_name}\t#{@aw_workspace_id}\t#{@aw_role}\t#{@aw_repository}\t#{@aw_set}' 2>/dev/null)

if ((${#workspace_labels[@]} == 0)); then
  dispatch_error 'No live managed sessions. Open a workspace first.'
  exit 1
fi

workspace_options=()
for workspace_id in "${!workspace_labels[@]}"; do
  workspace_options+=("󱃉"$'\t'"${workspace_labels[$workspace_id]}"$'\t'"$workspace_id")
done
if [[ -n ${AW_WORKSPACE_ID:-} ]]; then
  workspace_id=$AW_WORKSPACE_ID
  [[ -n ${workspace_labels[$workspace_id]:-} ]] || { dispatch_error 'The requested workspace has no live managed sessions.'; exit 1; }
elif ((${#workspace_labels[@]} == 1)); then
  # A chooser with one row looks like a dead end and adds no information.
  # Continue directly to the development-template step.
  workspace_id=${!workspace_labels[@]}
else
  if [[ ${AW_AUTO_CONFIRM:-0} == 1 ]]; then
    dispatch_error 'Select a workspace with --workspace.'; exit 1
  fi
  workspace_selection=$(printf '%s\n' "${workspace_options[@]}" | omarchy menu select 'Choose workspace' -- --width 420) || exit 0
  workspace_id=${workspace_selection##*$'\t'}
fi

if [[ ${AW_AUTO_CONFIRM:-0} == 1 && ( -z ${AW_TEMPLATE:-} || -z ${AW_OBJECTIVE:-} ) ]]; then
  dispatch_error 'Unattended dispatch requires a template and objective.'; exit 1
fi
if [[ -z ${AW_TEMPLATE:-} ]]; then
  operation=$(printf '%s\n' 'Start workflow' 'Change agents' | gum choose --header="${workspace_labels[$workspace_id]}") || exit 0
  [[ $operation != 'Change agents' ]] || exec agent-workspaces-agents "$workspace_id"
fi

declare -A role_sessions=()
declare -A role_panes=()
declare -A role_paths=()
declare -A role_providers=()
configured_roles=()
active_roles=()
active_count=0
expected_count=0
unavailable_roles=()
# Capture the producer completely: grep -q in a pipe can SIGPIPE it under pipefail.
available_providers=$(agent-workspaces available-providers) || {
  dispatch_error 'Cannot determine available providers.'; exit 1;
}

while IFS= read -r session; do
  [[ -n $session ]] || continue
  role=$(tmux show-option -qv -t "$session" @aw_role)
  provider=$(tmux show-option -qv -t "$session" @aw_provider); provider=${provider:-$role}
  grep -Fxq -- "$provider" <<<"$available_providers" || continue
  ((expected_count++))
  pane=$(tmux list-panes -t "$session" -F '#{pane_id}' | head -1)
  configured_roles+=("$role")
  role_paths["$role"]=$(tmux display-message -p -t "$pane" '#{pane_current_path}')
  role_providers["$role"]=$provider
  if agent-workspaces-pane-active "$provider" "$session"; then
    role_sessions["$role"]=$session
    role_panes["$role"]=$pane
    role_paths["$role"]=$(tmux display-message -p -t "$pane" '#{pane_current_path}')
    role_providers["$role"]=$provider
    active_roles+=("$role")
    ((active_count++))
  else
    unavailable_roles+=("$role ($provider)")
  fi
done <<<"${workspace_sessions[$workspace_id]}"

((expected_count > 0)) || { dispatch_error 'No enabled provider is available for this workspace.'; exit 1; }


template_root="$HOME/.config/agent-workspaces/templates"
if [[ -n ${AW_TEMPLATE:-} ]]; then
  template_id=$AW_TEMPLATE
else
  template_rows=()
  while IFS= read -r template_file; do
    template_rows+=("$(jq -r '[.id, .label, .description] | @tsv' "$template_file")")
  done < <(find "$template_root" -maxdepth 1 -type f -name '*.json' -print 2>/dev/null | sort)
  ((${#template_rows[@]} > 0)) || { dispatch_error 'No development templates are installed.'; exit 1; }
  template_selection=$(printf '%s\n' "${template_rows[@]}" | omarchy menu select 'Development template' -- --width 560) || exit 0
  template_id=${template_selection%%$'\t'*}
fi
template_file="$template_root/$template_id.json"
jq -e '.schema_version == 1 and (.id | type == "string")' "$template_file" >/dev/null 2>&1 || {
  dispatch_error "Invalid development template: $template_id"
  exit 1
}

if [[ -n ${AW_OBJECTIVE:-} ]]; then
  prompt=$AW_OBJECTIVE
else
  prompt=$(omarchy menu input 'Shared task for active agents' --width 620) || exit 0
fi
[[ -n ${prompt//[[:space:]]/} ]] || exit 0

stage=${AW_STAGE:-$(jq -r '.stage' "$template_file")}
difficulty=${AW_DIFFICULTY:-standard}
[[ $difficulty =~ ^(simple|standard|complex)$ ]] || { dispatch_error 'Invalid routing difficulty'; exit 1; }
case "$stage" in review|execute|verify|integrate) ;; *) dispatch_error "Unsupported workflow stage: $stage"; exit 1 ;; esac

lead_first=$(jq -r '.delivery_policy.lead_first | if . == null then true else . end' "$HOME/.config/agent-workspaces/config.json")
lead_only=false
[[ $lead_first == true && ( $stage == execute || $stage == integrate ) ]] && lead_only=true

assignment_root=$(agent-workspaces workspace-root "$workspace_id")
saved_lead=$(jq -r '.default_lead // empty' "$assignment_root/.coordination/agents.json" 2>/dev/null || true)
if [[ -n ${AW_LEAD:-} ]]; then
  lead=$AW_LEAD
  [[ -n ${role_sessions[$lead]:-} ]] || { dispatch_error "Requested lead is not active: $lead"; exit 1; }
elif [[ -n $saved_lead ]]; then
  lead=$saved_lead
  [[ -n ${role_sessions[$lead]:-} ]] || { dispatch_error 'Selected lead is not running; open Change agents to complete the handover.'; exit 1; }
elif ((active_count > 1)); then
  if [[ ${AW_AUTO_CONFIRM:-0} == 1 ]]; then
    dispatch_error 'No lead selected. Pass --lead SLOT or save a workspace lead.'; exit 1
  fi
  lead_options=()
  for role in "${active_roles[@]}"; do lead_options+=("󰒓"$'\t'"${role^}"$'\t'"$role"); done
  lead_selection=$(printf '%s\n' "${lead_options[@]}" | omarchy menu select "${stage^} lead" -- --width 380) || exit 0
  lead=${lead_selection#*$'\t'}
else
  ((active_count > 0)) || { dispatch_error "No agents are running; inspect quota and handovers."; exit 1; }
  lead=${active_roles[0]}
fi

if [[ $lead_only != true ]] && ((active_count < expected_count)); then
  if [[ ${AW_AUTO_CONFIRM:-0} == 1 ]]; then
    dispatch_error "$active_count/$expected_count agents ready; unavailable: ${unavailable_roles[*]}. Inspect quota and handover status; no task was dispatched."
    exit 1
  fi
  readiness=$(omarchy menu select "$active_count/$expected_count agents ready" \
    ""$'\t'"Open workspace and restore agents"$'\t'"open" \
    "󰜺"$'\t'"Cancel"$'\t'"cancel" -- --width 460) || exit 0
  if [[ ${readiness#*$'\t'} == open ]]; then
    exec env OMARCHY_AGENT_REPOSITORY="${workspace_repositories[$workspace_id]}" \
      OMARCHY_AGENT_SET="${workspace_sets[$workspace_id]}" omarchy-agent-grid
  fi
  exit 0
fi

# Retain unavailable reviewers as deferred assignments for later activation.
[[ $lead_only != true ]] || active_roles=("${configured_roles[@]}")

if [[ -f $assignment_root/.coordination/agents.json ]] && jq -e --arg lead "$lead" 'any(.requests[]; .slot==$lead and .role=="lead" and (.phase=="requested" or .phase=="ready" or .phase=="launching" or .phase=="awaiting_ack"))' "$assignment_root/.coordination/agents.json" >/dev/null; then
  dispatch_error 'A lead change is pending. Complete or cancel it in Change agents before dispatching another task.'
  exit 1
fi

repository=${workspace_repositories[$workspace_id]}
routing_guard=(--roles "$lead")
[[ $stage != review && $stage != verify ]] || routing_guard=(--review --roles "${active_roles[@]}")
agent-workspaces routing "$workspace_id" guard "${routing_guard[@]}" || { dispatch_error 'Capacity or handover prevents new work. Check workspace routing.'; exit 1; }
set_slug=${workspace_sets[$workspace_id]}
repo_name=$(basename "$repository")
repo_hash=${workspace_id%%:*}
task_id=$(date '+%Y%m%d-%H%M%S-%3N')
task_root="$HOME/.local/share/agent-workspaces/$repo_name-$repo_hash/$set_slug/.coordination/$task_id"
workspace_root=${task_root%/.coordination/*}
profile=$(jq -r '.profile // "trusted"' "$workspace_root/workspace.json" 2>/dev/null || printf trusted)
repair_round=0
if [[ -n ${AW_PARENT_TASK_ID:-} ]]; then
  parent_delivery_state="$workspace_root/.coordination/$AW_PARENT_TASK_ID/state.json"
  if [[ -f $parent_delivery_state ]]; then
    repair_round=$(jq -r '.delivery.repair_round // 0' "$parent_delivery_state")
    [[ $stage == execute ]] && ((repair_round+=1))
  fi
fi
seam=${AW_SEAM:-general}
allowed_paths=$(jq -c --arg seam "$seam" '.seams[$seam].paths // empty' "$HOME/.config/agent-workspaces/config.json")
[[ -n $allowed_paths ]] || { dispatch_error "Unknown ownership seam: $seam"; exit 1; }
while IFS= read -r active_state; do
  existing_id=$(jq -r '.id' "$active_state")
  existing_status=$(jq -r '.status' "$active_state")
  existing_seam=$(jq -r '.seam // empty' "$active_state")
  [[ -n $existing_seam ]] || continue
  # A seam is a write lease, not a permanent reservation. Once agents stop
  # executing, their reports remain auditable without blocking new work.
  [[ $existing_status == active || $existing_status == awaiting_configuration || $existing_status == dispatching ]] || continue
  [[ ${AW_PARENT_TASK_ID:-} == "$existing_id" ]] && continue
  if [[ $seam == general || $seam == shared || $existing_seam == general || $existing_seam == shared || $seam == "$existing_seam" ]]; then
    dispatch_error "Ownership conflict: '$seam' overlaps active task $existing_id ($existing_seam)."
    exit 1
  fi
done < <(find "$workspace_root/.coordination" -mindepth 2 -maxdepth 2 -name state.json -type f -print 2>/dev/null)

declare -A assignments=()
assignments["$lead"]=$(jq -r '.assignments.lead' "$template_file")
for role in "${active_roles[@]}"; do
  [[ $role == "$lead" ]] && continue
  if [[ -z ${analyst:-} ]]; then
    analyst=$role
    assignments["$role"]=$(jq -r '.assignments.reviewer' "$template_file")
  else
    verifier=$role
    assignments["$role"]=$(jq -r '.assignments.verifier' "$template_file")
  fi
done

if [[ ${AW_AUTO_CONFIRM:-0} != 1 ]]; then
  confirmation=$(omarchy menu select 'Dispatch coordinated task?' \
    "󰄬"$'\t'"Prepare workflow with $lead leading"$'\t'"send" \
    "󰜺"$'\t'"Cancel"$'\t'"cancel" -- --width 440) || exit 0
  [[ ${confirmation#*$'\t'} == send ]] || exit 0
fi

mkdir -p "$task_root"
mkdir -p "$task_root/instructions"
cp "$HOME/.config/agent-workspaces/protocol.md" "$task_root/PROTOCOL.md"
cp "$HOME/.config/agent-workspaces/instructions/CLAUDE.md" "$task_root/instructions/CLAUDE.md"
cp "$HOME/.config/agent-workspaces/instructions/AGENTS.md" "$task_root/instructions/AGENTS.md"
cp "$HOME/.config/agent-workspaces/instructions/GROK.md" "$task_root/instructions/GROK.md"
cp "$template_file" "$task_root/template.json"
{
  printf '# Agent Workspace Task %s\n\n' "$task_id"
  printf 'Stage: %s\n' "$stage"
  printf 'Template: %s · %s\n' "$template_id" "$(jq -r '.label' "$template_file")"
  [[ -n ${AW_PARENT_TASK_ID:-} ]] && printf 'Parent: %s\n' "$AW_PARENT_TASK_ID"
  printf 'Ownership seam: %s\n' "$seam"
  printf 'Allowed paths: %s\n' "$(jq -r 'join(", ")' <<<"$allowed_paths")"
  [[ -n ${AW_ISSUE:-} ]] && printf 'Issue: %s\n' "$AW_ISSUE"
  printf '\n'
  printf '## Objective\n\n%s\n\n' "$prompt"
  printf '## Coordination rules\n\n'
  printf -- '- This manifest is immutable after dispatch.\n'
  printf -- '- Work only inside your assigned worktree; never edit the integration checkout or another agent worktree.\n'
  printf -- '- Record progress, findings, commits, and blockers only in your own status file.\n'
  printf -- '- Integration is the merge gate. Do not merge branches yourself.\n\n'
  if ((active_count == 1)); then
    printf -- '- Solo-provider mode: implementation and self-review use one provider. Report this reduced assurance explicitly; do not claim independent cross-provider verification.\n\n'
  fi
  if [[ $lead_only == true ]]; then
    printf -- '- Lead-first delivery: reviewers remain deferred until the lead publishes an immutable commit.\n'
    printf -- '- Delivery capacity follows the participating providers’ available quota. Continue making useful progress while capacity remains; consolidate findings rather than spawning one workflow per finding.\n\n'
    printf -- '- Build economy: use focused debug-profile checks while implementing. Do not run release/LTO or full-workspace gates until the final candidate unless the defect is release-specific.\n'
    printf -- '- Final validation: after consolidated review repairs, run the complete repository gate once and reuse that exact-commit evidence across roles. Never share writable build directories between worktrees.\n\n'
  fi
  printf '## Required evidence\n\n'
  jq -r '.required_evidence[] | "- " + .' "$template_file"
  printf '\n'
  printf '## Assignments\n\n'
  for role in "${active_roles[@]}"; do
    printf -- '- **%s:** %s\n  - Worktree: `%s`\n  - Status: `%s/%s.status.md`\n' \
      "${role^}" "${assignments[$role]}" "${role_paths[$role]}" "$task_root" "$role"
  done
  printf '\n## Integration checklist\n\n'
  printf -- '- Review every status file and referenced commit.\n- Choose or combine changes intentionally.\n- Resolve overlaps in the integration checkout only.\n- Run final repository-wide validation before merging.\n'
} >"$task_root/task.md"

for role in "${active_roles[@]}"; do
  initial_state=dispatched
  [[ $lead_only == true && $role != "$lead" ]] && initial_state=deferred
  {
    printf '# %s status · %s\n\n' "${role^}" "$task_id"
    printf 'State: %s\n\n## Findings\n\n## Changes or commits\n\n## Blockers\n' "$initial_state"
  } >"$task_root/$role.status.md"
  jq -n --arg id "$task_id" --arg role "$role" --arg state "$initial_state" --arg at "$(date --iso-8601=seconds)" \
    '{schema_version:1,task_id:$id,role:$role,state:$state,summary:"",updated_at:$at,evidence:[],commits:[],changed_files:[],blockers:[]}' \
    >"$task_root/$role.status.json"
done

roles_json='{}'
for role in "${active_roles[@]}"; do
  initial_state=$(jq -r '.state' "$task_root/$role.status.json")
  roles_json=$(jq --arg role "$role" --arg assignment "${assignments[$role]}" --arg worktree "${role_paths[$role]}" \
    --arg provider "${role_providers[$role]}" --arg status_json "$task_root/$role.status.json" --arg report_file "$task_root/$role.status.md" --arg state "$initial_state" \
    '. + {($role): {provider:$provider, assignment: $assignment, worktree: $worktree, status_json: $status_json, report_file: $report_file, state:$state}}' <<<"$roles_json")
done
jq -n \
  --arg id "$task_id" \
  --arg workspace_id "$workspace_id" \
  --arg repository "$repository" \
  --arg set "$set_slug" \
  --arg objective "$prompt" \
  --arg seam "$seam" \
  --argjson allowed_paths "$allowed_paths" \
  --arg stage "$stage" \
  --arg profile "$profile" \
  --arg template_id "$template_id" \
  --argjson template_version "$(jq '.schema_version' "$template_file")" \
  --arg parent_id "${AW_PARENT_TASK_ID:-}" \
  --arg issue "${AW_ISSUE:-}" \
  --arg created_at "$(date --iso-8601=seconds)" \
  --arg lead "$lead" \
  --arg difficulty "$difficulty" \
  --argjson repair_round "$repair_round" \
  --argjson roles "$roles_json" \
  '{schema_version: 2, id: $id, workspace_id: $workspace_id, repository: $repository, set: $set,
    objective: $objective, seam: $seam, allowed_paths: $allowed_paths, stage: $stage, template_id: $template_id, template_version: $template_version,
    profile: $profile, status: "awaiting_configuration", parent_id: $parent_id, issue: $issue, pr: {}, lead: $lead,
    delivery: {mode:"quota-aware",continue_while_capacity_remains:true,repair_round:$repair_round}, routing:{difficulty:$difficulty},
    created_at: $created_at, updated_at: $created_at, roles: $roles,
    gates: {triage_approved: false, execution_approved: false, integration_approved: false, pr_prepared: false, pr_approved: false},
    transitions: [{from: null, to: "awaiting_configuration", at: $created_at, actor: "dispatcher"}]}' >"$task_root/state.json"

workspace_manifest="$workspace_root/workspace.json"
if [[ ! -f $workspace_manifest ]]; then
  configured_providers=$(jq -c '.providers' "$HOME/.config/agent-workspaces/config.json")
  jq -n --arg id "$workspace_id" --arg repository "$repository" --arg set "$set_slug" --arg profile "$profile" --arg at "$(date --iso-8601=seconds)" \
    --argjson providers "$configured_providers" \
    '{schema_version:2,workspace_id:$id,repository:$repository,set:$set,profile:$profile,layout:"adaptive-grid",providers:$providers,created_at:$at,updated_at:$at}' >"$workspace_manifest"
fi
agent-workspaces dispatch-ready "$task_root" || true
joined='queued or dispatched according to configuration readiness'
source "$HOME/.local/share/agent-workspaces-app/$(cat "$HOME/.local/share/agent-workspaces-app/current-version")/lib/core.sh" 2>/dev/null || true
if declare -F aw_audit >/dev/null; then aw_audit "$workspace_root" task.queued "$(jq -cn --arg id "$task_id" --arg template "$template_id" --arg profile "$profile" '{task_id:$id,template:$template,profile:$profile}')" user; fi
notify-send 'Coordinated task prepared' "$joined · $task_id · ${workspace_labels[$workspace_id]}"
printf '%s\n' "$task_root"
