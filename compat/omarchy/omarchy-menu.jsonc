{
  // Extend the Quickshell Omarchy menu with JSONC.
  //
  // IDs are object keys. The parent is inferred from the dotted id, so
  // "personal.notes" appears under "personal", and "personal" appears on the
  // root menu. Reuse an existing id to override/extend it.
  //
  // Fields:
  //   icon        Nerd Font glyph shown in the icon column.
  //   label       Visible row title.
  //   action      Shell command to run. If omitted, the row is a submenu.
  //   target      Existing submenu id to open. Use for links/aliases.
  //   provider    Runtime provider function/command returning JSON rows.
  //   aliases     alternate `omarchy menu summon <name>` routes; also searchable.
  //   description Optional subtitle and extra search text.
  //   when        Shell condition; hide row when it fails.
  //   checked     Shell condition; append ✓ when it succeeds.
  //
  // Examples:
  // "personal": {"icon":"","label":"Personal"},
  // "personal.notes": {"icon":"󰎞","label":"Notes","action":"omarchy-launch-editor ~/notes"},
  // "personal.files": {"icon":"","label":"Files","action":"uwsm-app -- nautilus ~/Documents"},
  //
  // Only use provider when a provider_name function or command named "name"
  // returns JSON rows. Static submenus only need dotted ids.
  //
  // Example: replace the default About action by reusing the same id. Existing
  // fields are kept unless overridden.
  // "about": {"icon":"","label":"About","action":"omarchy-launch-or-focus-tui \"zsh -c 'fastfetch; read -k 1'\""},
  "agent-launch": {"icon":"󰚩","label":"Agent Workspaces","aliases":["agent","agents","workspace-agent"],"description":"Coding agents, isolated worktrees, and coordinated workflows"},
  "agent-launch.grid": {"icon":"󱃉","label":"Open Workspace","action":"omarchy-launch-floating-terminal-with-presentation omarchy-agent-grid","description":"Open Claude, Codex, Grok, and a conversational orchestrator"},
  "agent-launch.manage": {"icon":"󰆍","label":"Manage Workspaces","action":"omarchy-launch-floating-terminal-with-presentation omarchy-agent-grid-manage","description":"Open, hide, or end all four windows together"},
  "agent-launch.health": {"icon":"󰓅","label":"Workspace Health","action":"omarchy-launch-floating-terminal-with-presentation agent-workspaces dashboard","description":"Agents, tasks, branches, worktree risk, and recent activity"},
  "agent-launch.dispatcher": {"icon":"󰒍","label":"Workflow Dispatcher","action":"omarchy-launch-floating-terminal-with-presentation omarchy-agent-dispatcher","description":"Review, triage, execute, verify, integrate, and prepare a PR"},
  "agent-launch.prompt": {"icon":"󰭹","label":"Prompt Agents","action":"omarchy-agent-prompt-launch","description":"Dispatch one coordinated task with lead, analyst, and verifier roles"},
  "agent-launch.sessions": {"icon":"","label":"Tmux Sessions","action":"omarchy-launch-floating-terminal-with-presentation tmux panel","description":"Browse persistent agent and terminal sessions"},
  "agent-launch.choose": {"icon":"","label":"Single Agent","action":"omarchy-launch-floating-terminal-with-presentation omarchy-agent-workspace","description":"Choose an agent, model, and project"},
  "agent-launch.updates": {"icon":"󰚰","label":"Provider Updates","action":"omarchy-launch-floating-terminal-with-presentation omarchy-agent-provider-updates","description":"Update Claude, Codex, Grok, and future provider CLIs through their owning manager"},
  "agent-launch.default": {"icon":"","label":"Default Agent","action":"omarchy-agent","description":"Launch the configured default"},
}
