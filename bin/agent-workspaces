#!/bin/bash

set -euo pipefail
source "${AW_LIB:-$(dirname "$(realpath "$0")")/../lib/core.sh}"

usage() {
  sed -n '/^## Commands/,/^Run /p' "$(dirname "$(realpath "$0")")/../README.md"
}

cmd=${1:-help}; shift || true
case "$cmd" in
  help|-h|--help) usage ;;
  version|--version) printf '%s\n' "$AW_VERSION" ;;
  doctor)
    failed=0
    for dep in bash git jq flock tmux fzf gum hyprctl gh; do
      if command -v "$dep" >/dev/null; then printf 'ok       %s\n' "$dep"; else printf 'missing  %s\n' "$dep"; failed=1; fi
    done
    for provider in "$AW_PROVIDER_HOME"/*.json; do
      jq -e '.schema_version==1 and (.id|type=="string") and (.profiles|has("safe") and has("trusted") and has("yolo"))' "$provider" >/dev/null || { printf 'invalid  %s\n' "$provider"; failed=1; }
    done
    printf 'config   %s\nstate    %s\n' "$AW_CONFIG_HOME" "$AW_DATA_HOME"
    exit "$failed"
    ;;
  provider-command)
    provider=${1:?provider}; mode=${2:?fresh or resume}; profile=${3:?profile}; session_id=${4:-}
    aw_provider_command "$provider" "$mode" "$profile" "$session_id"
    ;;
  discover-session)
    provider=${1:?provider}; directory=${2:?directory}; found=''
    case "$provider" in
      claude)
        while IFS= read -r file; do
          found=$(jq -rs --arg cwd "$directory" '[.[]|select(.cwd==$cwd and (.sessionId//"")!="")|.sessionId][0]//empty' "$file" 2>/dev/null)
          [[ -n $found ]] && break
        done < <(find "$HOME/.claude/projects" -type f -name '*.jsonl' -printf '%T@ %p\n' 2>/dev/null | sort -nr | cut -d' ' -f2-)
        ;;
      codex)
        while IFS= read -r file; do
          found=$(sed -n '1,20p' "$file" | jq -rs --arg cwd "$directory" '[.[]|select(.type=="session_meta" and .payload.cwd==$cwd)|(.payload.session_id//.payload.id)][0]//empty' 2>/dev/null)
          [[ -n $found ]] && break
        done < <(find "$HOME/.codex/sessions" -type f -name '*.jsonl' -printf '%T@ %p\n' 2>/dev/null | sort -nr | cut -d' ' -f2-)
        ;;
      grok)
        encoded=${directory//\//%2F}; session_root="$HOME/.grok/sessions/$encoded"
        [[ -d $session_root ]] && found=$(find "$session_root" -mindepth 1 -maxdepth 1 -type d -printf '%T@ %f\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-)
        ;;
      *) aw_die "unknown provider: $provider" ;;
    esac
    [[ -n $found ]] && printf '%s\n' "$found"
    ;;
  remember-session)
    session=${1:?tmux session}; provider=${2:?provider}; directory=${3:?directory}
    session_id=$("$0" discover-session "$provider" "$directory" || true)
    if [[ -n $session_id ]]; then
      tmux set-option -q -t "$session" @aw_provider_session_id "$session_id"
      printf '%s\n' "$session_id"
    fi
    ;;
  status)
    task='' role='' state='' summary='' command_run='' exit_code='' blocker=''; commits=(); changed_files=()
    while (($#)); do
      case "$1" in
        --task) task=$2; shift 2;; --role) role=$2; shift 2;; --state) state=$2; shift 2;;
        --summary) summary=$2; shift 2;; --command) command_run=$2; shift 2;; --exit-code) exit_code=$2; shift 2;;
        --blocker) blocker=$2; shift 2;; --commit) commits+=("$2"); shift 2;; --file) changed_files+=("$2"); shift 2;;
        *) aw_die "unknown status option: $1";;
      esac
    done
    [[ -n $task && -n $role && -n $state ]] || aw_die 'status requires --task, --role, and --state'
    aw_valid_state "$state" || aw_die "invalid state: $state"
    [[ -d $task ]] || aw_die "task directory not found: $task"
    status_file="$task/$role.status.json"; now=$(aw_now)
    if [[ ! -f $status_file ]]; then
      jq -n --arg id "$(basename "$task")" --arg role "$role" --arg at "$now" \
        '{schema_version:1,task_id:$id,role:$role,state:"dispatched",summary:"",updated_at:$at,evidence:[],commits:[],changed_files:[],blockers:[]}' >"$status_file"
    fi
    if [[ $state == blocked && -z $blocker && $(jq '.blockers|length' "$status_file") -eq 0 ]]; then
      aw_die 'blocked status requires --blocker evidence'
    fi
    if [[ $state == completed ]]; then
      task_stage=$(jq -r '.stage' "$task/state.json")
      final_summary=$summary; [[ -n $final_summary ]] || final_summary=$(jq -r '.summary // empty' "$status_file")
      [[ -n $final_summary ]] || aw_die 'completed status requires a summary'
      if [[ $task_stage =~ ^(execute|verify)$ && -z $command_run && $(jq '.evidence|length' "$status_file") -eq 0 ]]; then
        aw_die 'execute/verify completion requires command evidence'
      fi
      if [[ -n $command_run && $exit_code != 0 ]]; then aw_die 'completion evidence must have a zero exit code'; fi
    fi
    args=(--arg state "$state" --arg summary "$summary" --arg at "$now")
    filter='.state=$state | .updated_at=$at | if $summary!="" then .summary=$summary else . end'
    if [[ -n $command_run ]]; then
      [[ $exit_code =~ ^-?[0-9]+$ ]] || aw_die '--exit-code is required and must be numeric with --command'
      args+=(--arg command "$command_run" --argjson exit_code "$exit_code")
      filter+=' | .evidence += [{command:$command,exit_code:$exit_code,at:$at}]'
    fi
    if [[ -n $blocker ]]; then args+=(--arg blocker "$blocker"); filter+=' | .blockers += [$blocker] | .blockers |= unique'; fi
    if ((${#commits[@]})); then
      commits_json=$(printf '%s\n' "${commits[@]}" | jq -Rsc 'split("\n")|map(select(length>0))')
      args+=(--argjson commits "$commits_json"); filter+=' | .commits += $commits | .commits |= unique'
    fi
    if ((${#changed_files[@]})); then
      files_json=$(printf '%s\n' "${changed_files[@]}" | jq -Rsc 'split("\n")|map(select(length>0))')
      args+=(--argjson files "$files_json"); filter+=' | .changed_files += $files | .changed_files |= unique'
    fi
    aw_atomic_jq "$status_file" "${args[@]}" "$filter"
    workspace_root=${task%/.coordination/*}
    aw_audit "$workspace_root" role.status "$(jq -cn --arg task "$(basename "$task")" --arg role "$role" --arg state "$state" '{task_id:$task,role:$role,state:$state}')" "$role"
    aw_task_refresh "$task" >/dev/null
    printf '%s\n' "$status_file"
    ;;
  refresh) aw_task_refresh "${1:?task directory}" ;;
  audit)
    task=${1:?task directory}; event=${2:?event}; actor=${3:-user}; details=${4:-'{}'}
    [[ -f $task/state.json ]] || aw_die "missing task: $task"
    jq -e . <<<"$details" >/dev/null || aw_die 'audit details must be JSON'
    aw_audit "${task%/.coordination/*}" "$event" "$details" "$actor"
    ;;
  health)
    workspace_id=${1:-}
    if [[ -z $workspace_id ]]; then
      tmux list-sessions -F '#{@aw_workspace_id}' 2>/dev/null | awk 'NF' | sort -u
      exit 0
    fi
    aw_workspace_risks "$workspace_id"
    ;;
  snapshot)
    workspace_id=${1:?workspace id}; shift
    write=false
    [[ ${1:-} == --write ]] && write=true
    workspace_root=$(aw_workspace_root "$workspace_id") || aw_die "unknown workspace: $workspace_id"
    manifest="$workspace_root/workspace.json"
    repository=$(jq -r '.repository' "$manifest")
    set_slug=$(jq -r '.set' "$manifest")
    now=$(aw_now)
    content=$(mktemp)
    {
      printf '# Agent Workspace · %s\n\n' "$set_slug"
      printf 'Updated: %s  \nRepository: `%s`  \nWorkspace: `%s`\n\n' "$now" "$repository" "$workspace_id"
      printf '## Sessions\n\n```text\n'
      aw_workspace_risks "$workspace_id"
      printf '```\n\n## Workflows\n\n'
      found=false
      while IFS= read -r state; do
        found=true
        task=$(dirname "$state")
        aw_task_refresh "$task" >/dev/null || true
        jq -r '"- `" + .id + "` · **" + .status + "** · " + .stage + " · " + .objective,
          (.roles | to_entries[] | "  - " + .key + ": " + (.value.state // "dispatched"))' "$state"
        next_label=$(aw_next_actions_json "$task" | jq -r '.[0].label // "No further action"')
        printf '  - Next: %s\n' "$next_label"
      done < <(find "$workspace_root/.coordination" -mindepth 2 -maxdepth 2 -name state.json -type f -print 2>/dev/null | sort -r)
      [[ $found == true ]] || printf '_No workflows dispatched yet._\n'
      printf '\n## Recent activity\n\n'
      if [[ -s $workspace_root/.coordination/audit.jsonl ]]; then
        tail -n 8 "$workspace_root/.coordination/audit.jsonl" | jq -r '"- " + .at + " · " + .event + " · " + .actor'
      else
        printf '_No recorded activity yet._\n'
      fi
    } >"$content"
    if [[ $write == true ]]; then
      target="$workspace_root/.orchestrator/snapshot.md"
      mkdir -p "$(dirname "$target")"
      mv "$content" "$target"
      printf '%s\n' "$target"
    else
      cat "$content"
      rm -f "$content"
    fi
    ;;
  monitor)
    workspace_id=${1:?workspace id}
    interval=$(jq -r '.monitor_interval_seconds // 15' "$AW_CONFIG_FILE")
    [[ $interval =~ ^[0-9]+$ && $interval -ge 5 ]] || interval=15
    workspace_root=$(aw_workspace_root "$workspace_id") || aw_die "unknown workspace: $workspace_id"
    signature_file="$workspace_root/.orchestrator/.state-signature"
    while :; do
      snapshot_file=$("$0" snapshot "$workspace_id" --write 2>/dev/null || true)
      if [[ -s $snapshot_file ]]; then
        signature=$(sed '/^Updated:/d' "$snapshot_file" | sha256sum | awk '{print $1}')
        previous=''; [[ -f $signature_file ]] && read -r previous <"$signature_file"
        printf '%s\n' "$signature" >"$signature_file"
        if [[ -n $previous && $signature != "$previous" ]]; then
          "$0" attention "$workspace_id" >/dev/null 2>&1 || true
          "$0" event-review "$workspace_id" >/dev/null 2>&1 &
        fi
      fi
      sleep "$interval"
    done
    ;;
  attention)
    workspace_id=${1:?workspace id}
    workspace_root=$(aw_workspace_root "$workspace_id") || aw_die "unknown workspace: $workspace_id"
    attention_file="$workspace_root/.orchestrator/attention.md"
    temporary=$(mktemp "$workspace_root/.orchestrator/.attention.md.XXXXXX")
    {
      printf '# Human decisions\n\nUpdated: %s\n\n' "$(aw_now)"
      found=false
      while IFS= read -r state; do
        task=$(dirname "$state"); status=$(jq -r '.status' "$state")
        action=$(aw_next_actions_json "$task" | jq -c '.[0] // empty')
        [[ -n $action ]] || continue
        action_id=$(jq -r '.id' <<<"$action")
        [[ $action_id != wait ]] || continue
        found=true
        printf '## %s · %s\n\n' "$(basename "$task")" "$status"
        printf '%s\n\n' "$(jq -r '.label' <<<"$action")"
        objective=$(jq -r '(.objective // "") | gsub("[\\r\\n]+"; " ") | if length > 420 then .[:417] + "..." else . end' "$state")
        printf 'Objective: %s\n\n' "$objective"
        break
      done < <(find "$workspace_root/.coordination" -mindepth 2 -maxdepth 2 -name state.json -type f -print 2>/dev/null | sort -r)
      [[ $found == true ]] || printf '_No human decision is currently required._\n'
    } >"$temporary"
    new_signature=$(sed '/^Updated:/d' "$temporary" | sha256sum | awk '{print $1}')
    old_signature=''; [[ -f $attention_file ]] && old_signature=$(sed '/^Updated:/d' "$attention_file" | sha256sum | awk '{print $1}')
    mv "$temporary" "$attention_file"
    if [[ $new_signature != "$old_signature" ]] && rg -q '^## ' "$attention_file"; then
      headline=$(awk '/^## / {sub(/^## /, ""); print; exit}' "$attention_file")
      recommendation=$(awk 'found && NF {print; exit} /^## / {found=1}' "$attention_file")
      notify-send -a 'Agent Workspaces' 'Workflow decision required' "$headline · $recommendation" 2>/dev/null || true
    fi
    printf '%s\n' "$attention_file"
    ;;
  monitor-start)
    workspace_id=${1:?workspace id}
    workspace_root=$(aw_workspace_root "$workspace_id") || aw_die "unknown workspace: $workspace_id"
    unit_slug=$(sed -E 's/[^[:alnum:]_.-]+/-/g' <<<"$workspace_id" | cut -c1-80)
    unit="agent-workspaces-monitor-$unit_slug.service"
    if systemctl --user is-active --quiet "$unit"; then exit 0; fi
    systemd-run --user --quiet --unit="${unit%.service}" --collect \
      /usr/bin/flock -n "$workspace_root/.orchestrator/.monitor.lock" "$0" monitor "$workspace_id"
    ;;
  monitor-stop)
    workspace_id=${1:?workspace id}
    unit_slug=$(sed -E 's/[^[:alnum:]_.-]+/-/g' <<<"$workspace_id" | cut -c1-80)
    systemctl --user stop "agent-workspaces-monitor-$unit_slug.service" 2>/dev/null || true
    ;;
  event-review)
    workspace_id=${1:?workspace id}
    workspace_root=$(aw_workspace_root "$workspace_id") || aw_die "unknown workspace: $workspace_id"
    orchestrator_root="$workspace_root/.orchestrator"
    snapshot_file="$orchestrator_root/snapshot.md"
    [[ -s $snapshot_file ]] || "$0" snapshot "$workspace_id" --write >/dev/null
    enabled=$(jq -r '.event_reviewer.enabled // false' "$AW_CONFIG_FILE")
    [[ $enabled == true ]] || exit 0
    provider=$(jq -r '.event_reviewer.provider // "codex"' "$AW_CONFIG_FILE")
    model=$(jq -r '.event_reviewer.model // empty' "$AW_CONFIG_FILE")
    [[ $provider == codex ]] || aw_die "event reviewer provider is not supported yet: $provider"
    [[ -n $model ]] || aw_die 'event reviewer model is not configured'
    exec {review_lock}>"$orchestrator_root/.event-review.lock"
    flock -n "$review_lock" || exit 0
    temporary=$(mktemp "$orchestrator_root/.briefing.md.XXXXXX")
    trap 'rm -f "$temporary"' EXIT
    {
      printf '%s\n\n' 'You are a lightweight event reviewer. Compare no prior narrative; summarize only the material current state in the snapshot below.'
      printf '%s\n' 'Write at most 160 words with: What changed or matters now; Risks or blockers; Recommended next action. Do not run tools, edit files, dispatch work, or ask questions.'
      cat "$snapshot_file"
    } | codex exec --ephemeral --skip-git-repo-check --sandbox read-only --model "$model" \
      --output-last-message "$temporary" - >/dev/null 2>&1 || exit 0
    [[ -s $temporary ]] || exit 0
    {
      printf '# Event briefing\n\nGenerated: %s  \nModel: `%s`\n\n' "$(aw_now)" "$model"
      cat "$temporary"
      printf '\n'
    } >"$orchestrator_root/briefing.md"
    ;;
  dispatch)
    workspace_id='' template='' objective='' lead='' seam=general
    while (($#)); do
      case "$1" in
        --workspace) workspace_id=$2; shift 2 ;;
        --template) template=$2; shift 2 ;;
        --objective) objective=$2; shift 2 ;;
        --lead) lead=$2; shift 2 ;;
        --seam) seam=$2; shift 2 ;;
        *) aw_die "unknown dispatch option: $1" ;;
      esac
    done
    [[ -n $workspace_id && -n $template && -n $objective && -n $lead ]] || \
      aw_die 'dispatch requires --workspace, --template, --objective, and --lead'
    exec env AW_WORKSPACE_ID="$workspace_id" AW_TEMPLATE="$template" AW_OBJECTIVE="$objective" \
      AW_LEAD="$lead" AW_SEAM="$seam" AW_AUTO_CONFIRM=1 omarchy-agent-prompt
    ;;
  sync)
    workspace_id=${1:?workspace id}; shift
    confirmed=false
    while (($#)); do
      case "$1" in
        --confirmed-by-user) confirmed=true; shift ;;
        *) aw_die "unknown sync option: $1" ;;
      esac
    done
    workspace_root=$(aw_workspace_root "$workspace_id") || aw_die "unknown workspace: $workspace_id"
    manifest="$workspace_root/workspace.json"; repository=$(jq -r '.repository' "$manifest")
    git -C "$repository" fetch --prune origin
    base=$(aw_origin_base "$repository")
    paths=(); roles=()
    while IFS= read -r role; do
      path="$workspace_root/$role"
      [[ -d $path ]] || continue
      roles+=("$role"); paths+=("$path")
    done < <(jq -r '.providers[]' "$manifest")
    printf 'Base: %s\n' "$base"
    dirty_found=false
    for index in "${!paths[@]}"; do
      role=${roles[$index]}; path=${paths[$index]}
      branch=$(git -C "$path" branch --show-current); dirty=$(git -C "$path" status --porcelain | wc -l)
      read -r behind ahead < <(git -C "$path" rev-list --left-right --count "$base...HEAD")
      printf '%-10s %-42s behind=%s ahead=%s dirty=%s\n' "$role" "$branch" "$behind" "$ahead" "$dirty"
      ((dirty > 0)) && dirty_found=true
    done
    [[ $confirmed == true ]] || exit 0
    [[ $dirty_found == false ]] || aw_die 'sync requires every worker worktree to be clean'
    for index in "${!paths[@]}"; do
      role=${roles[$index]}; path=${paths[$index]}
      git -C "$path" rebase "$base" || { git -C "$path" rebase --abort 2>/dev/null || true; aw_die "rebase failed for $role"; }
    done
    aw_audit "$workspace_root" workspace.synced "$(jq -cn --arg base "$base" --arg machine "$(jq -r '.machine_id // "legacy"' "$manifest")" '{base:$base,machine_id:$machine}')" user:confirmed-via-orchestrator
    ;;
  next)
    task=${1:?task directory}
    "$0" refresh "$task" >/dev/null
    state="$task/state.json"
    jq -n --arg task "$(basename "$task")" --arg status "$(jq -r '.status' "$state")" \
      --arg stage "$(jq -r '.stage' "$state")" --argjson actions "$(aw_next_actions_json "$task")" \
      '{task_id:$task,status:$status,stage:$stage,actions:$actions}'
    ;;
  advance)
    task=${1:?task directory}; action=${2:?action}; shift 2
    confirmed=false; title=''; evidence=''
    while (($#)); do
      case "$1" in
        --confirmed-by-user) confirmed=true; shift ;;
        --title) title=$2; shift 2 ;;
        --evidence) evidence=$2; shift 2 ;;
        *) aw_die "unknown advance option: $1" ;;
      esac
    done
    [[ $confirmed == true ]] || aw_die 'advance requires --confirmed-by-user after explicit human approval'
    state="$task/state.json"; [[ -f $state ]] || aw_die "missing task: $task"
    "$0" refresh "$task" >/dev/null
    status=$(jq -r '.status' "$state"); now=$(aw_now); workspace_root=${task%/.coordination/*}
    case "$action" in
      approve-integration)
        [[ $status == awaiting_integration ]] || aw_die "approve-integration requires awaiting_integration, found $status"
        jq -e '[.roles[].state] | all(.=="completed")' "$state" >/dev/null || aw_die 'all assigned roles must be completed'
        collision=$(aw_collision_json "$task")
        printf '%s\n' "$collision" | jq . >"$task/collision-report.json"
        [[ $(jq -r '.safe' <<<"$collision") == true ]] || aw_die 'agent branches have unresolved integration collisions'
        temporary=$(mktemp "$task/.state.json.XXXXXX")
        jq --arg at "$now" '.gates.integration_approved=true | .status="integration_ready" | .updated_at=$at | .transitions += [{from:"awaiting_integration",to:"integration_ready",at:$at,actor:"user:confirmed-via-orchestrator"}]' "$state" >"$temporary" && mv "$temporary" "$state"
        aw_audit "$workspace_root" integration.approved '{"collision_check":"passed"}' user:confirmed-via-orchestrator
        ;;
      record-integration)
        [[ $status == integration_ready ]] || aw_die "record-integration requires integration_ready, found $status"
        [[ -n ${evidence//[[:space:]]/} ]] || aw_die 'record-integration requires --evidence'
        integration_branch=$(jq -r '.integration.branch // empty' "$state")
        [[ -n $integration_branch ]] || aw_die 'no integration commit plan has been applied'
        repository=$(jq -r '.repository' "$state")
        [[ $(git -C "$repository" branch --show-current) == "$integration_branch" ]] || aw_die 'integration checkout is not on the recorded integration branch'
        [[ -z $(git -C "$repository" status --porcelain) ]] || aw_die 'integration checkout is dirty'
        printf '# Integration result\n\n%s\n' "$evidence" >"$task/integration-result.md"
        temporary=$(mktemp "$task/.state.json.XXXXXX")
        jq --arg at "$now" '.status="awaiting_pr" | .updated_at=$at | .transitions += [{from:"integration_ready",to:"awaiting_pr",at:$at,actor:"user:confirmed-via-orchestrator"}]' "$state" >"$temporary" && mv "$temporary" "$state"
        aw_audit "$workspace_root" integration.recorded "$(jq -cn --arg evidence "$evidence" '{evidence:$evidence}')" user:confirmed-via-orchestrator
        ;;
      prepare-pr)
        [[ $status == awaiting_pr ]] || aw_die "prepare-pr requires awaiting_pr, found $status"
        [[ -n ${title//[[:space:]]/} ]] || aw_die 'prepare-pr requires --title'
        printf '# PR readiness\n\nTitle: %s\n\n- [ ] Integration commits reviewed\n- [ ] Full validation gate passed\n- [ ] Formatting and lint passed\n- [ ] Issue references verified\n- [ ] Human approval to publish\n' "$title" >"$task/pr-checklist.md"
        [[ -f $task/pr-body.md ]] || printf 'Agent Workspaces task `%s`. Evidence and role reports are recorded in the workflow.\n' "$(basename "$task")" >"$task/pr-body.md"
        temporary=$(mktemp "$task/.state.json.XXXXXX")
        jq --arg at "$now" --arg title "$title" '.gates.pr_prepared=true | .pr.title=$title | .status="awaiting_pr_review" | .updated_at=$at | .transitions += [{from:"awaiting_pr",to:"awaiting_pr_review",at:$at,actor:"user:confirmed-via-orchestrator"}]' "$state" >"$temporary" && mv "$temporary" "$state"
        aw_audit "$workspace_root" pr.prepared "$(jq -cn --arg title "$title" '{title:$title}')" user:confirmed-via-orchestrator
        ;;
      approve-pr)
        [[ $status == awaiting_pr_review ]] || aw_die "approve-pr requires awaiting_pr_review, found $status"
        [[ -f $task/integration-result.md ]] || aw_die 'integration evidence is missing'
        temporary=$(mktemp "$task/.state.json.XXXXXX")
        jq --arg at "$now" '.gates.pr_approved=true | .status="ready_for_pr" | .updated_at=$at | .transitions += [{from:"awaiting_pr_review",to:"ready_for_pr",at:$at,actor:"user:confirmed-via-orchestrator"}]' "$state" >"$temporary" && mv "$temporary" "$state"
        aw_audit "$workspace_root" pr.approved '{}' user:confirmed-via-orchestrator
        ;;
      *) aw_die "unsupported advance action: $action" ;;
    esac
    "$0" next "$task"
    ;;
  dashboard)
    mapfile -t ids < <(tmux list-sessions -F '#{@aw_workspace_id}' 2>/dev/null | awk 'NF' | sort -u)
    ((${#ids[@]})) || aw_die 'no live Agent Workspaces'
    rows=()
    for id in "${ids[@]}"; do
      summary=$(aw_workspace_risks "$id" | tail -1)
      rows+=("$id"$'\t'"$id  ·  $summary")
    done
    selection=$(printf '%s\n' "${rows[@]}" | fzf --delimiter=$'\t' --with-nth=2 --accept-nth=1 --layout=reverse --no-border --pointer='›' --prompt='Health  ' --preview='agent-workspaces health {1}' --preview-window='down,65%,border-top') || exit 0
    aw_workspace_risks "$selection"
    ;;
  collision)
    task=${1:?task directory}
    result=$(aw_collision_json "$task")
    printf '%s\n' "$result" | jq .
    if [[ $(jq -r '.safe' <<<"$result") != true ]]; then exit 2; fi
    ;;
  reconcile-pr)
    task=${1:?task directory}; shift
    pr=''
    while (($#)); do
      case "$1" in
        --pr) pr=$2; shift 2 ;;
        *) aw_die "unknown reconcile-pr option: $1" ;;
      esac
    done
    [[ $pr =~ ^[0-9]+$ ]] || aw_die 'reconcile-pr requires a numeric --pr'
    state="$task/state.json"; [[ -f $state ]] || aw_die 'missing state.json'
    repository=$(jq -r '.repository' "$state")
    pr_json=$(cd "$repository" && gh pr view "$pr" --json number,url,state,mergedAt,mergeCommit,statusCheckRollup) || aw_die "cannot read PR #$pr"
    [[ $(jq -r '.state' <<<"$pr_json") == MERGED && $(jq -r '.mergedAt // empty' <<<"$pr_json") != '' ]] || aw_die "PR #$pr is not merged"
    failing_checks=$(jq '[.statusCheckRollup[]? | select((.conclusion // .state // "") as $c | ($c != "SUCCESS" and $c != "SKIPPED" and $c != "NEUTRAL"))] | length' <<<"$pr_json")
    merge_oid=$(jq -r '.mergeCommit.oid // empty' <<<"$pr_json"); merged_at=$(jq -r '.mergedAt' <<<"$pr_json"); url=$(jq -r '.url' <<<"$pr_json")
    now=$(aw_now); previous=$(jq -r '.status' "$state")
    aw_atomic_jq "$state" --argjson number "$pr" --arg url "$url" --arg merged_at "$merged_at" --arg merge_oid "$merge_oid" \
      --arg at "$now" --arg from "$previous" --argjson failing_checks "$failing_checks" \
      '.status="completed" | .stage="complete" | .updated_at=$at |
       .pr += {number:$number,url:$url,state:"MERGED",merged_at:$merged_at,merge_commit:$merge_oid,failing_checks:$failing_checks} |
       .transitions += [{from:$from,to:"completed",at:$at,actor:"system:github-reconciliation"}]'
    aw_audit "${task%/.coordination/*}" pr.merged.reconciled \
      "$(jq -cn --arg task "$(basename "$task")" --argjson pr "$pr" --arg url "$url" --arg merge_commit "$merge_oid" --argjson failing_checks "$failing_checks" '{task_id:$task,pr:$pr,url:$url,merge_commit:$merge_commit,failing_checks:$failing_checks}')" \
      system:github-reconciliation
    printf 'Task %s reconciled to completed from merged PR #%s (%s, failing checks recorded: %s).\n' "$(basename "$task")" "$pr" "$merge_oid" "$failing_checks"
    ;;
  integrate)
    task=${1:?task directory}; shift
    confirmed=false; commits=()
    while (($#)); do
      case "$1" in
        --confirmed-by-user) confirmed=true; shift ;;
        --commit) commits+=("$2"); shift 2 ;;
        *) aw_die "unknown integrate option: $1" ;;
      esac
    done
    [[ $confirmed == true ]] || aw_die 'integrate requires --confirmed-by-user after explicit human approval'
    ((${#commits[@]})) || aw_die 'integrate requires at least one --commit'
    state="$task/state.json"; [[ -f $state ]] || aw_die 'missing state.json'
    [[ $(jq -r '.status' "$state") == integration_ready ]] || aw_die 'task must be integration_ready'
    jq -e '.gates.integration_approved==true' "$state" >/dev/null || aw_die 'integration handoff is not approved'
    repository=$(jq -r '.repository' "$state")
    [[ -z $(git -C "$repository" status --porcelain) ]] || aw_die 'integration checkout is dirty'
    original_branch=$(git -C "$repository" branch --show-current)
    [[ -n $original_branch ]] || aw_die 'integration checkout is detached'
    for commit in "${commits[@]}"; do
      git -C "$repository" cat-file -e "$commit^{commit}" 2>/dev/null || aw_die "unknown commit: $commit"
      jq -e --arg commit "$commit" '[.roles[].status_json] | map(select(. != null))' "$state" >/dev/null
      reported=false
      while IFS= read -r status_json; do
        [[ -f $status_json ]] || continue
        jq -e --arg commit "$commit" '.commits | index($commit) != null' "$status_json" >/dev/null && { reported=true; break; }
      done < <(jq -r '.roles[].status_json // empty' "$state")
      [[ $reported == true ]] || aw_die "commit was not reported by an assigned agent: $commit"
    done
    set_slug=$(jq -r '.set' "$state"); task_id=$(basename "$task")
    branch=$(sed -E 's/[^[:alnum:]_.\/-]+/-/g' <<<"integration/$set_slug/$task_id")
    git -C "$repository" show-ref --verify --quiet "refs/heads/$branch" && aw_die "integration branch already exists: $branch"
    git -C "$repository" switch -c "$branch"
    integrated=()
    for commit in "${commits[@]}"; do
      if git -C "$repository" merge-base --is-ancestor "$commit" HEAD; then continue; fi
      if ! git -C "$repository" cherry-pick "$commit"; then
        git -C "$repository" cherry-pick --abort 2>/dev/null || true
        git -C "$repository" switch "$original_branch" >/dev/null 2>&1 || true
        git -C "$repository" branch -D "$branch" >/dev/null 2>&1 || true
        aw_die "integration conflict while cherry-picking $commit; checkout restored"
      fi
      integrated+=("$commit")
    done
    commits_json=$(printf '%s\n' "${commits[@]}" | jq -Rsc 'split("\n") | map(select(length>0))')
    jq -n --arg branch "$branch" --arg base "$original_branch" --arg at "$(aw_now)" --argjson commits "$commits_json" \
      '{branch:$branch,base_branch:$base,selected_commits:$commits,integrated_at:$at}' >"$task/integration-plan.json"
    aw_atomic_jq "$state" --arg branch "$branch" --arg at "$(aw_now)" --argjson commits "$commits_json" \
      '.integration={branch:$branch,selected_commits:$commits,integrated_at:$at} | .updated_at=$at'
    aw_audit "${task%/.coordination/*}" integration.commits.selected "$(jq -cn --arg branch "$branch" --argjson commits "$commits_json" '{branch:$branch,commits:$commits}')" user:confirmed-via-orchestrator
    printf 'Integration branch: %s\nSelected commits: %s\n' "$branch" "${commits[*]}"
    ;;
  end)
    workspace_id=${1:?workspace id}
    aw_workspace_risks "$workspace_id"
    if command -v gum >/dev/null && [[ -t 0 ]]; then gum confirm "End every $workspace_id session after this warning?" || exit 0; fi
    root=$(aw_workspace_root "$workspace_id" 2>/dev/null || true)
    [[ -n $root ]] && aw_audit "$root" workspace.end.requested "$(jq -cn --arg id "$workspace_id" '{workspace_id:$id}')" user
    mapfile -t sessions < <(tmux list-sessions -F $'#{session_name}\t#{@aw_workspace_id}' 2>/dev/null | awk -F '\t' -v id="$workspace_id" '$2==id {print $1}')
    for session in "${sessions[@]}"; do tmux send-keys -t "$session" C-c 2>/dev/null || true; done
    sleep 1
    for session in "${sessions[@]}"; do tmux kill-session -t "$session" 2>/dev/null || true; done
    "$0" monitor-stop "$workspace_id"
    printf 'Ended %s sessions. Worktrees and provider history remain.\n' "${#sessions[@]}"
    ;;
  recover)
    workspace_id=${1:?workspace id}; requested_role=${2:-}
    while IFS=$'\t' read -r session role; do
      [[ -z $requested_role || $role == "$requested_role" ]] || continue
      [[ $role != integration ]] || continue
      provider=$(tmux show-option -qv -t "$session" @aw_provider); provider=${provider:-$role}
      omarchy-agent-pane-active "$role" "$session" 2>/dev/null && continue
      directory=$(tmux display-message -p -t "$session" '#{pane_current_path}')
      workspace_root=$(aw_workspace_root "$workspace_id" 2>/dev/null || true)
      if [[ $role == orchestrator ]]; then
        profile=$(jq -r '.orchestrator_profile // "trusted"' "$AW_CONFIG_FILE")
      elif [[ -n $workspace_root && -f $workspace_root/workspace.json ]]; then
        profile=$(jq -r '.profile // "trusted"' "$workspace_root/workspace.json")
      else
        profile=$(tmux show-option -qv -t "$session" @aw_profile); profile=${profile:-trusted}
      fi
      tmux set-option -q -t "$session" @aw_profile "$profile"
      session_id=$(tmux show-option -qv -t "$session" @aw_provider_session_id)
      if [[ -z $session_id ]]; then
        session_id=$("$0" discover-session "$provider" "$directory" || true)
        [[ -n $session_id ]] && tmux set-option -q -t "$session" @aw_provider_session_id "$session_id"
      fi
      command=$(aw_provider_command "$provider" resume "$profile" "$session_id")
      [[ $role == orchestrator ]] && command="AW_WORKSPACE_ID=$(printf %q "$workspace_id") $command"
      pane=$(tmux list-panes -t "$session" -F '#{pane_id}' | head -1)
      tmux send-keys -t "$pane" -l -- "$command"; tmux send-keys -t "$pane" Enter
      printf 'Relaunched %s in %s (%s).\n' "$role" "$directory" "$profile"
    done < <(tmux list-sessions -F $'#{session_name}\t#{@aw_role}\t#{@aw_workspace_id}' 2>/dev/null | awk -F '\t' -v id="$workspace_id" '$3==id {print $1 "\t" $2}')
    ;;
  archive)
    archive_root="$AW_DATA_HOME/.archives"; mkdir -p "$archive_root"
    days=$(jq -r '.archive_after_days // 30' "$AW_CONFIG_FILE")
    while IFS= read -r state; do
      task=$(dirname "$state"); status=$(jq -r '.status' "$state")
      [[ $status =~ ^(completed|draft_pr|ready_for_pr)$ ]] || continue
      find "$task" -maxdepth 0 -mtime "+$days" -print | grep -q . || continue
      workspace_root=${task%/.coordination/*}; workspace_key=$(basename "$(dirname "$workspace_root")")-$(basename "$workspace_root"); id=$(basename "$task")
      target="$archive_root/$workspace_key-$id.tar.zst"
      [[ -f $target ]] && continue
      tar --zstd -cf "$target" -C "$(dirname "$task")" "$id"
      checksum=$(sha256sum "$target" | awk '{print $1}')
      jq -cn --arg id "$id" --arg file "$target" --arg checksum "$checksum" --arg at "$(aw_now)" '{task_id:$id,file:$file,sha256:$checksum,archived_at:$at}' >>"$archive_root/index.jsonl"
      aw_audit "$workspace_root" task.archived "$(jq -cn --arg id "$id" --arg file "$target" '{task_id:$id,file:$file}')"
    done < <(find "$AW_DATA_HOME" -path '*/.coordination/*/state.json' -type f -print 2>/dev/null)
    ;;
  publish)
    task=${1:?task directory}; shift
    confirmed=false
    while (($#)); do
      case "$1" in --confirmed-by-user) confirmed=true; shift ;; *) aw_die "unknown publish option: $1" ;; esac
    done
    state="$task/state.json"; [[ -f $state ]] || aw_die 'missing state.json'
    [[ $(jq -r '.status' "$state") == ready_for_pr ]] || aw_die 'task must be ready_for_pr'
    jq -e '.gates.integration_approved==true and .gates.pr_prepared==true and .gates.pr_approved==true' "$state" >/dev/null || aw_die 'integration and PR gates are not all approved'
    jq -e '[.roles[].state] | all(.=="completed")' "$state" >/dev/null || aw_die 'every required role must be completed'
    collision=$(aw_collision_json "$task")
    [[ $(jq -r '.safe' <<<"$collision") == true ]] || aw_die 'agent branches have unresolved integration collisions'
    repository=$(jq -r '.repository' "$state"); title=$(jq -r '.pr.title // .objective' "$state"); branch=$(git -C "$repository" branch --show-current)
    [[ -n $branch ]] || aw_die 'integration checkout is detached'
    [[ -z $(git -C "$repository" status --porcelain) ]] || aw_die 'integration checkout is dirty'
    git -C "$repository" fetch --prune origin
    base=$(aw_origin_base "$repository")
    read -r behind _ < <(git -C "$repository" rev-list --left-right --count "$base...HEAD")
    ((behind == 0)) || aw_die "integration branch is $behind commit(s) behind $base; sync/rebase and revalidate before publishing"
    gh auth status >/dev/null 2>&1 || aw_die 'GitHub CLI is not authenticated'
    printf 'Repository: %s\nBranch: %s\nTitle: %s\n' "$repository" "$branch" "$title"
    if [[ $confirmed != true ]]; then gum confirm 'Push this branch and open a draft pull request?' || exit 0; fi
    git -C "$repository" push -u origin "$branch"
    body_file="$task/pr-body.md"; [[ -f $body_file ]] || printf 'Agent Workspaces task `%s`. Evidence is recorded locally.\n' "$(basename "$task")" >"$body_file"
    url=$(cd "$repository" && gh pr create --draft --title "$title" --body-file "$body_file")
    aw_atomic_jq "$state" --arg url "$url" --arg at "$(aw_now)" '.status="draft_pr" | .pr.url=$url | .updated_at=$at | .transitions += [{from:"ready_for_pr",to:"draft_pr",at:$at,actor:"user:published"}]'
    aw_audit "${task%/.coordination/*}" pr.draft.created "$(jq -cn --arg id "$(basename "$task")" --arg url "$url" '{task_id:$id,url:$url}')" user
    printf '%s\n' "$url"
    ;;
  migrate) exec "$(dirname "$(realpath "$0")")/../packaging/migrate" ;;
  rollback) exec "$(dirname "$(realpath "$0")")/../packaging/rollback" ;;
  *) aw_die "unknown command: $cmd" ;;
esac
