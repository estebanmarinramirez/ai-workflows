{
  "schema_version": 1,
  "id": "codex",
  "label": "OpenAI Codex",
  "executable": "codex",
  "process_pattern": "-codex,",
  "update": {"manager": "mise", "tool": "codex"},
  "fresh": ["codex", "--model", "gpt-5.6-sol"],
  "resume": ["codex", "resume", "{session_id}", "--model", "gpt-5.6-sol"],
  "continue": ["codex", "resume", "--last", "--model", "gpt-5.6-sol"],
  "profiles": {
    "safe": ["--sandbox", "workspace-write", "--ask-for-approval", "on-request"],
    "trusted": ["--approve-for-me"],
    "yolo": ["--dangerously-bypass-approvals-and-sandbox"]
  }
}
