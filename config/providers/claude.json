{
  "schema_version": 1,
  "id": "claude",
  "label": "Claude Code",
  "executable": "claude",
  "process_pattern": "-claude,",
  "update": {"manager": "mise", "tool": "claude"},
  "fresh": ["claude", "--model", "fable", "--effort", "high"],
  "resume": ["claude", "--resume", "{session_id}", "--model", "fable", "--effort", "high"],
  "continue": ["claude", "--continue", "--model", "fable", "--effort", "high"],
  "profiles": {
    "safe": ["--permission-mode", "manual"],
    "trusted": ["--permission-mode", "acceptEdits"],
    "yolo": ["--permission-mode", "bypassPermissions"]
  }
}
