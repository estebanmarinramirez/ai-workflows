{
  "schema_version": 1,
  "default_profile": "yolo",
  "default_layout": "three-plus-orchestrator",
  "orchestrator_provider": "claude",
  "orchestrator_model": "fable",
  "orchestrator_profile": "yolo",
  "model_policy": {
    "quality_tier": "frontier",
    "claude": {"model": "opus", "effort": "high"},
    "codex": {"model": "gpt-5.6-sol", "effort": "high"},
    "grok": {"model": "grok-4.6", "effort": "high", "plan": "Ultra"},
    "event_reviewer": {"model": "gpt-5.6-luna", "effort": "low"}
  },
  "build_policy": {
    "iteration": "focused-debug-checks",
    "final_gate_runs": 1,
    "release_build_phase": "final-candidate",
    "compiler_cache": "auto-sccache",
    "share_target_directories": false
  },
  "monitor_interval_seconds": 15,
  "idle_status_grace_seconds": 45,
  "delivery_policy": {
    "mode": "quota-aware",
    "continue_while_capacity_remains": true,
    "lead_first": true,
    "full_gate_phase": "final",
    "review_requires_lead_commit": true
  },
  "event_reviewer": {
    "enabled": true,
    "provider": "codex",
    "model": "gpt-5.6-luna"
  },
  "archive_after_days": 30,
  "delete_archives_automatically": false,
  "project_roots": ["~/Work", "~/Projects", "~/Code", "~/Developer"],
  "repository_catalog": {
    "github_owners": ["estebanmarinramirez"],
    "github_ttl_seconds": 900,
    "clone_root": "~/Developer",
    "max_depth": 12,
    "exclude_names": [
      ".cache", ".local", ".Trash", "Trash", "node_modules", "target",
      ".venv", "venv", "vendor", "Library"
    ]
  },
  "seams": {
    "general": {"label": "General repository work", "paths": ["**"]},
    "desktop": {"label": "Desktop and platform integration", "paths": ["desktop/**", "platform/**", "**/omarchy/**", "**/*omarchy*"]},
    "execution": {"label": "Execution core and exchange integrations", "paths": ["execution/**", "exchanges/**", "connectors/**"]},
    "tui": {"label": "Terminal UI and information architecture", "paths": ["tui/**", "ui/**"]},
    "shared": {"label": "Explicitly shared surfaces", "paths": ["Cargo.lock", "**/palette/**", "**/*command*"]}
  },
  "providers": ["claude", "codex", "grok"],
  "solo_agent_slots": 3
}
