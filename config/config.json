{
  "schema_version": 1,
  "default_profile": "yolo",
  "default_layout": "three-plus-orchestrator",
  "orchestrator_provider": "claude",
  "orchestrator_model": "fable",
  "orchestrator_profile": "yolo",
  "model_policy": {
    "quality_tier": "frontier",
    "claude": {
      "model": "opus",
      "effort": "high"
    },
    "codex": {
      "model": "gpt-6.1-sol",
      "effort": "high"
    },
    "grok": {
      "model": "grok-4.6",
      "effort": "high",
      "plan": "Ultra"
    },
    "event_reviewer": {
      "model": "gpt-6-luna",
      "effort": "low"
    }
  },
  "build_policy": {
    "iteration": "focused-debug-checks",
    "final_gate_runs": 1,
    "release_build_phase": "final-candidate",
    "compiler_cache": "auto-sccache",
    "share_target_directories": false
  },
  "monitor_interval_seconds": 15,
  "idle_status_grace_seconds": 45,
  "delivery_policy": {
    "mode": "quota-aware",
    "continue_while_capacity_remains": true,
    "lead_first": true,
    "full_gate_phase": "final",
    "review_requires_lead_commit": true
  },
  "event_reviewer": {
    "enabled": true,
    "provider": "codex",
    "model": "gpt-6-luna"
  },
  "archive_after_days": 30,
  "delete_archives_automatically": false,
  "project_roots": [
    "~/Work",
    "~/Projects",
    "~/Code",
    "~/Developer"
  ],
  "repository_catalog": {
    "github_owners": [
      "estebanmarinramirez"
    ],
    "github_ttl_seconds": 900,
    "clone_root": "~/Developer",
    "max_depth": 12,
    "exclude_names": [
      ".cache",
      ".local",
      ".Trash",
      "Trash",
      "node_modules",
      "target",
      ".venv",
      "venv",
      "vendor",
      "Library"
    ]
  },
  "seams": {
    "general": {
      "label": "General repository work",
      "paths": [
        "**"
      ]
    },
    "desktop": {
      "label": "Desktop and platform integration",
      "paths": [
        "desktop/**",
        "platform/**",
        "**/omarchy/**",
        "**/*omarchy*"
      ]
    },
    "execution": {
      "label": "Execution core and exchange integrations",
      "paths": [
        "execution/**",
        "exchanges/**",
        "connectors/**"
      ]
    },
    "tui": {
      "label": "Terminal UI and information architecture",
      "paths": [
        "tui/**",
        "ui/**"
      ]
    },
    "shared": {
      "label": "Explicitly shared surfaces",
      "paths": [
        "Cargo.lock",
        "**/palette/**",
        "**/*command*"
      ]
    }
  },
  "providers": [
    "claude",
    "codex",
    "grok"
  ],
  "solo_agent_slots": 3,
  "routing": {
    "mode": "automatic",
    "effort_mode": "fixed",
    "manage_orchestrator": true,
    "telemetry_ttl_seconds": 300,
    "reserve_fraction": 0.15,
    "pressure_fraction": 0.7,
    "switch_improvement": 0.15,
    "cooldown_seconds": 900,
    "account_pools": {},
    "allowed_models": {},
    "profiles": {
      "simple": {
        "claude": {
          "model": "sonnet",
          "effort": "medium",
          "pressure_effort": "low"
        },
        "codex": {
          "model": "gpt-6-luna",
          "effort": "medium",
          "pressure_effort": "low"
        },
        "grok": {
          "model": "grok-4.7-build-fast",
          "effort": "medium",
          "pressure_effort": "low"
        }
      },
      "standard": {
        "claude": {
          "effort": "high",
          "pressure_effort": "medium"
        },
        "codex": {
          "effort": "high",
          "pressure_effort": "medium"
        },
        "grok": {
          "effort": "high",
          "pressure_effort": "medium"
        }
      },
      "complex": {
        "claude": {
          "effort": "xhigh",
          "pressure_effort": "high"
        },
        "codex": {
          "effort": "xhigh",
          "pressure_effort": "high"
        },
        "grok": {
          "effort": "xhigh",
          "pressure_effort": "high"
        }
      }
    }
  },
  "telemetry": {
    "enabled": true
  }
}
