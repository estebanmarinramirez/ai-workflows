#!/usr/bin/env python3
"""Exercise real tmux transport in a private server, never an agent session."""
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time
from unittest.mock import patch

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
import gestures as g

with tempfile.TemporaryDirectory(prefix='aw-gesture-transport-') as directory:
    root = Path(directory)
    receiver = root / 'receiver.py'
    receiver.write_text("""import os, tty, sys
from pathlib import Path
tty.setraw(0)
os.write(1, b'\\x1b[?2004h')
Path(sys.argv[1]+'.ready').touch()
data = b''
while True:
    data += os.read(0, 4096)
    Path(sys.argv[1]).write_bytes(data)
""")
    base = ['tmux', '-S', str(root / 'tmux.sock')]
    try:
        subprocess.run(base + ['-f', '/dev/null', 'new-session', '-d', '-s', 'receiver',
                               sys.executable, str(receiver), str(root / 'received')], check=True)
        deadline = time.monotonic() + 5
        while not (root / 'received.ready').exists() and time.monotonic() < deadline:
            time.sleep(.05)
        assert (root / 'received.ready').exists(), 'receiver did not start'
        pane = subprocess.check_output(base + ['list-panes', '-t', 'receiver', '-F', '#{pane_id}'], text=True).strip()
        target = g.Target('test', 'receiver', pane, 'test', 'test', '', 'test', 'test')
        actual_command = g.command
        def transport(args, text=None):
            assert args[0] == 'tmux', args
            return actual_command(base + args[1:], text)
        desktop = g.Desktop()
        # Identity checks are tested separately against fixtures and live panes.
        # Only the private test recipient bypasses those checks here.
        with patch.object(g, 'command', side_effect=transport), patch.object(desktop, 'validate'):
            desktop.paste(target, g.clean_text('gesture demo\nmessage'))
            desktop.send(target)
        expected = b'\x1b[200~gesture demo message\x1b[201~\r'
        deadline = time.monotonic() + 3
        while time.monotonic() < deadline:
            if (root / 'received').exists() and (root / 'received').read_bytes() == expected:
                break
            time.sleep(.05)
        assert (root / 'received').read_bytes() == expected, 'unexpected terminal input'
        print('PASS: real tmux delivered one bracketed paste and exactly one Enter')
    finally:
        subprocess.run(base + ['kill-server'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
