#!/usr/bin/env python3
"""Measured comparison safeguards; fixtures are never live training evidence."""
import copy,hashlib,json,sys,tempfile,unittest
from pathlib import Path
sys.dont_write_bytecode=True
ROOT=Path(__file__).resolve().parents[1];sys.path.insert(0,str(ROOT/'lib'))
import dream_compare

class Comparison(unittest.TestCase):
 def setUp(self):
  self.tmp=tempfile.TemporaryDirectory();self.addCleanup(self.tmp.cleanup);self.root=Path(self.tmp.name)
  self.docs=[];self.spec=dict(schema_version=1,difficulty='standard',incumbent='low',candidates=[])
  for effort,score in [('low',0),('medium',1)]:
   agent=dict(provider='claude',model='sonnet',effort=effort)
   doc=dict(schema_version=1,data_kind='real',evaluation_protocol='test',agent=agent,objective=dict(quality=1,cost_usd=1,wall_seconds=.01,attempts=.01),incumbent='p',policies=[dict(id='p',strategy='breadth',workers=1,rounds=1)],worlds=[])
   for i in range(6):
    node=dict(id='a',parent='root',score=score,wall_seconds=1,cost_usd=.01,snapshot='result',attempt_id='attempt'+str(i),configuration='test',requested_agent=agent,verifier_version='test',evidence_sha256='a'*64)
    doc['worlds'].append(dict(id=str(i),instance_id=str(i),split='development' if i<3 else 'heldout',root_score=0,root_snapshot='base',prompt_sha256='b'*64,verifier_sha256='c'*64,nodes=[node]))
   self.docs.append(doc);self.spec['candidates'].append(dict(id=effort,export=effort+'.json',policy='p'))
 def run_compare(self):
  for candidate,doc in zip(self.spec['candidates'],self.docs):
   raw=json.dumps(doc).encode();(self.root/candidate['export']).write_bytes(raw);candidate['sha256']=hashlib.sha256(raw).hexdigest()
  path=self.root/'comparison.json';path.write_text(json.dumps(self.spec));return dream_compare.compare(path)
 def test_supported_improvement_is_reviewable_not_automatic(self):
  result=self.run_compare();self.assertEqual(result['recommendation'],'medium');self.assertFalse(result['automatic_promotion'])
  self.assertEqual(result['routing_profile_proposal']['budget']['profiles']['claude']['standard']['effort'],'medium')
 def test_heldout_does_not_select_configuration(self):
  before=self.run_compare()
  for w in self.docs[1]['worlds'][3:]:w['nodes'][0]['score']=0
  after=self.run_compare();self.assertEqual(before['development'],after['development']);self.assertEqual(after['selected'],'medium');self.assertIsNone(after['recommendation'])
 def test_abstention(self):
  for doc in self.docs:doc['data_kind']='synthetic';doc['worlds']=doc['worlds'][:2]+doc['worlds'][3:5]
  r=self.run_compare();self.assertIsNone(r['recommendation']);self.assertIn('synthetic_data',r['abstention_reasons']);self.assertIn('insufficient_development_instances',r['abstention_reasons'])
 def test_mismatched_evidence_configuration_and_cost_rejected(self):
  baseline=copy.deepcopy(self.docs)
  for kind in ('protocol','prompt','agent','cost','policy','solved'):
   self.docs=copy.deepcopy(baseline);d=self.docs[1]
   if kind=='protocol':d['evaluation_protocol']='other'
   if kind=='prompt':d['worlds'][0]['prompt_sha256']='d'*64
   if kind=='agent':d['worlds'][0]['nodes'][0]['requested_agent']={'model':'other'}
   if kind=='cost':d['worlds'][0]['nodes'][0]['cost_usd']=None
   if kind=='policy':d['policies'][0]['workers']=2
   if kind=='solved':d['worlds'][0]['root_score']=1
   with self.subTest(kind=kind),self.assertRaises(ValueError):self.run_compare()
 def test_hash_pin(self):
  self.run_compare();(self.root/'low.json').write_text('{}')
  with self.assertRaisesRegex(ValueError,'changed'):dream_compare.compare(self.root/'comparison.json')
if __name__=='__main__':unittest.main()
