#!/usr/bin/env python3
import math,os,sys,tempfile,unittest
from pathlib import Path
from unittest.mock import patch
sys.dont_write_bytecode=True
sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'lib'))
from dream_statistics import paired_evidence
from dream_evaluation import evaluation

class Evidence(unittest.TestCase):
 def test_known_bound_and_small_sample_abstention(self):
  r=paired_evidence([(1,0)]*3)
  self.assertFalse(r['supported'])
  large=paired_evidence([(1,0)]*100)
  self.assertAlmostEqual(large['lower_bound'],1-4*math.sqrt(math.log(20)/200))
  self.assertTrue(large['supported'])
 def test_null_negative_and_clipped_results_abstain(self):
  for pairs in ([],[(0,0)]*100,[(0,1)]*100,[(100,0)]*100):
   self.assertFalse(paired_evidence(pairs)['supported'])
  self.assertTrue(paired_evidence([(100,0)])['bounds_breached'])
 def test_invalid_parameters(self):
  for kwargs in ({'alpha':0},{'alpha':True},{'minimum_gain':-1},{'utility_bounds':[1,0]},{'utility_bounds':[0,float('inf')]}):
   with self.assertRaises(ValueError):paired_evidence([],**kwargs)
 def test_interruption_claim_survives_and_cross_protocol_reuse_is_blocked(self):
  with tempfile.TemporaryDirectory() as tmp,patch.dict(os.environ,XDG_STATE_HOME=tmp):
   with self.assertRaises(RuntimeError):
    with evaluation('first',['task']):raise RuntimeError('interrupted')
   with self.assertRaisesRegex(ValueError,'interrupted'):
    with evaluation('first',['task']):pass
   with self.assertRaisesRegex(ValueError,'exposed'):
    with evaluation('second',['task']):pass
   with evaluation('fresh',['other']) as holder:holder['result']={'done':True}
   with evaluation('fresh',['other']) as holder:self.assertEqual(holder['cached'],{'done':True})
if __name__=='__main__':unittest.main()
