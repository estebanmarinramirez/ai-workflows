#!/bin/bash
# Integration must start from the approved base, never from whatever the
# integration checkout happens to be on. Disposable local repositories only.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
fixture=$(mktemp -d)
trap 'rm -rf "$fixture"' EXIT
export HOME="$fixture/home" XDG_CONFIG_HOME="$fixture/config" XDG_DATA_HOME="$fixture/data" XDG_STATE_HOME="$fixture/state"
mkdir -p "$HOME" "$XDG_CONFIG_HOME/agent-workspaces" "$XDG_STATE_HOME"
cp "$root/config/config.json" "$XDG_CONFIG_HOME/agent-workspaces/config.json"
unset AW_WORKSPACE_ID AW_HANDOVER_ID AW_HANDOVER_TARGET || true
export GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.invalid GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.invalid
cli() { AW_LIB="$root/lib/core.sh" "$root/bin/agent-workspaces" "$@"; }
fail() { printf 'not ok - %s\n' "$*" >&2; exit 1; }
expect_fail() { # description, then a command; the command must fail and must not leave a branch behind
  local what=$1; shift
  if "$@" >"$fixture/out" 2>&1; then fail "$what was accepted: $(cat "$fixture/out")"; fi
}
git_() { git -C "$checkout" "$@"; }

# origin has a non-main default branch and has moved far past the stale checkout.
origin=$fixture/origin.git
git init -q --bare -b trunk "$origin"
seed=$fixture/seed
git clone -q "$origin" "$seed" 2>/dev/null
git -C "$seed" checkout -q -b trunk
printf 'one\n' >"$seed/file.txt"; git -C "$seed" add file.txt; git -C "$seed" commit -qm one
git -C "$seed" push -q origin trunk
checkout=$fixture/checkout
git clone -q "$origin" "$checkout"
git_ checkout -q -b architecture-review
printf 'review\n' >"$checkout/review.txt"; git_ add review.txt; git_ commit -qm 'architecture review only'
for i in 2 3 4; do printf '%s\n' "$i" >"$seed/n$i.txt"; git -C "$seed" add .; git -C "$seed" commit -qm "trunk $i"; done
git -C "$seed" push -q origin trunk
git_ fetch -q origin
git_ remote set-head origin trunk >/dev/null

# An assigned agent's worktree with two reported commits on top of trunk's tip.
agent=$fixture/agent
git_ worktree add -q -b agents/x/set/grok "$agent" origin/trunk
printf 'feature\n' >"$agent/feature.txt"; git -C "$agent" add .; git -C "$agent" commit -qm feature
feature=$(git -C "$agent" rev-parse HEAD)
printf 'feature2\n' >>"$agent/feature.txt"; git -C "$agent" commit -qam feature2
feature2=$(git -C "$agent" rev-parse HEAD)
git_ checkout -q architecture-review

workspace=$XDG_DATA_HOME/agent-workspaces/repo-hash/set
task=$workspace/.coordination/t1
mkdir -p "$task"
jq -n '{schema_version:2,workspace_id:"x:set",repository:"/tmp",set:"set",profile:"trusted",providers:["claude"]}' >"$workspace/workspace.json"
jq -n --arg c1 "$feature" --arg c2 "$feature2" '{schema_version:1,task_id:"t1",role:"grok",state:"completed",summary:"",updated_at:"x",evidence:[],commits:[$c1,$c2],changed_files:["feature.txt"],blockers:[]}' >"$task/grok.status.json"
write_state() {
  jq -n --arg repo "$checkout" --arg agent "$agent" --arg task "$task" --arg status "$1" \
    '{schema_version:2,id:"t1",workspace_id:"x:set",repository:$repo,set:"set",stage:"execute",status:$status,objective:"o",lead:"grok",
      updated_at:"2026-10-22T00:00:00+02:00",roles:{grok:{state:"completed",worktree:$agent,status_json:($task+"/grok.status.json")}},
      gates:{integration_approved:true},transitions:[]}' >"$task/state.json"
}
write_state integration_ready
refs() { git_ for-each-ref --format='%(refname) %(objectname)'; }
no_branch() { ! git_ show-ref --verify --quiet "refs/heads/integration/set/t1"; }
trunk=$(git_ rev-parse origin/trunk)
stale=$(git_ rev-parse HEAD)

# next advertises preflight, apply, then evidence recording.
ids=$(cli next "$task" | jq -r '[.actions[].id] | join(",")')
[[ $ids == plan-integration,integrate ]] || fail "next before apply advertised: $ids"

# Preflight is read-only and resolves the non-main default branch.
before=$(refs; git_ status --porcelain)
plan=$(cli integrate "$task" --plan --commit "$feature" --commit "$feature2")
[[ $before == "$(refs; git_ status --porcelain)" ]] || fail 'plan changed the checkout'
[[ $(jq -r '.base.ref' <<<"$plan") == origin/trunk && $(jq -r '.base.sha' <<<"$plan") == "$trunk" ]] || fail "plan base: $(jq -c .base <<<"$plan")"
[[ $(jq -r '.base.source' <<<"$plan") == origin-default ]] || fail 'plan did not mark the origin default'
[[ $(jq -r '.original.branch + " " + .original.sha' <<<"$plan") == "architecture-review $stale" ]] || fail 'plan lost the original checkout'
[[ $(jq -r '.ready' <<<"$plan") == true && $(jq -r '.commits | length' <<<"$plan") == 2 ]] || fail 'plan not ready'
jq -e '.apply | contains("--base-sha '"$trunk"'")' <<<"$plan" >/dev/null || fail 'plan did not carry an apply command'
no_branch || fail 'plan created a branch'
# origin/HEAD is optional: the remote's default branch is still found without a hardcoded name.
git_ symbolic-ref --delete refs/remotes/origin/HEAD
[[ $(cli integrate "$task" --plan --commit "$feature" | jq -r '.base.ref') == origin/trunk ]] || fail 'remote default branch not discovered'
git_ remote set-head origin trunk >/dev/null

# The preflight writes nothing: not task state, not role reports, not audit or workspace files.
tree_hash() { (cd "$workspace" && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum); }
write_state integration_ready # fresh state, so a hidden refresh would be visible
before=$(tree_hash)
cli integrate "$task" --plan --commit "$feature" --commit "$feature2" >/dev/null
cli integrate "$task" --plan --base origin/trunk --commit "$feature" >/dev/null
[[ $before == "$(tree_hash)" ]] || fail 'plan changed task, audit or workspace files'

# An explicit base survives into the printed apply command, which must run as printed
# (even for a ref name full of shell metacharacters) and record that base.
odd='origin/rel$HOME;x'
git_ branch release origin/trunk~1
git_ update-ref "refs/remotes/$odd" origin/trunk~2
for chosen in release origin/release "$odd"; do
  [[ $chosen == origin/release ]] && git_ update-ref refs/remotes/origin/release origin/trunk~1
  want=$(git_ rev-parse "$chosen^{commit}")
  refs_before=$(refs)
  before=$(tree_hash)
  plan=$(cli integrate "$task" --plan --base "$chosen" --commit "$feature" --commit "$feature2")
  [[ $before == "$(tree_hash)" ]] || fail "plan --base $chosen changed files"
  [[ $(jq -r '.base.ref + " " + .base.sha + " " + .base.source' <<<"$plan") == "$chosen $want explicit" ]] || fail "plan base for $chosen: $(jq -c .base <<<"$plan")"
  apply=$(jq -r .apply <<<"$plan")
  [[ $apply == agent-workspaces\ integrate\ * ]] || fail "unexpected apply command: $apply"
  eval "cli ${apply#agent-workspaces }" >"$fixture/out" 2>&1 || fail "printed apply command failed for $chosen: $(cat "$fixture/out")"
  jq -e --arg ref "$chosen" --arg sha "$want" '.integration | .base_ref == $ref and .base_sha == $sha and .base_source == "explicit"' "$task/state.json" >/dev/null || fail "recorded base for $chosen: $(jq -c .integration "$task/state.json")"
  [[ $(git_ rev-list --count "$want..HEAD") == 2 && $(git_ merge-base HEAD "$want") == "$want" ]] || fail "branch for $chosen does not start at the chosen base"
  git_ merge-base --is-ancestor architecture-review HEAD && fail 'stale checkout history leaked into an explicit-base integration'
  git_ checkout -q architecture-review; git_ branch -q -D integration/set/t1
  [[ $refs_before == "$(refs)" ]] || fail "applying a plan for $chosen changed unrelated refs"
  write_state integration_ready
done
# The printed command is shell-safe for awkward task paths: it parses back to the same words.
spaced="$workspace/.coordination/t 1"; cp -a "$task" "$spaced"
plan=$(cli integrate "$spaced" --plan --base release --commit "$feature")
apply=$(jq -r .apply <<<"$plan")
eval "words=(${apply#agent-workspaces })"
[[ ${words[0]} == integrate && ${words[1]} == "$spaced" && ${words[2]} == --base-sha ]] || fail "printed command did not round-trip: $(jq -r .apply <<<"$plan")"
rm -rf "$spaced"
# Real movement of the explicit base is still refused until the plan is refreshed.
plan=$(cli integrate "$task" --plan --base release --commit "$feature")
apply=$(jq -r .apply <<<"$plan")
git_ update-ref refs/heads/release "$(git_ commit-tree 'release^{tree}' -p release -m moved)"
expect_fail 'explicit base that moved' eval "cli ${apply#agent-workspaces }"
grep -q 'changed since the plan' "$fixture/out" || fail "no drift guidance for explicit base: $(cat "$fixture/out")"
no_branch && [[ $(git_ branch --show-current) == architecture-review ]] || fail 'explicit-base drift changed the checkout'
git_ branch -q -D release; git_ update-ref -d refs/remotes/origin/release; git_ update-ref -d "refs/remotes/$odd"

# Refusals leave the checkout untouched: missing approval of the base, unknown inputs, dirty tree.
before=$(refs)
expect_fail 'apply without an approved base' cli integrate "$task" --commit "$feature" --confirmed-by-user
grep -q -- '--plan' "$fixture/out" || fail "no actionable guidance: $(cat "$fixture/out")"
expect_fail 'apply without confirmation' cli integrate "$task" --base-sha "$trunk" --commit "$feature"
expect_fail 'unknown base' cli integrate "$task" --base no-such-ref --base-sha "$trunk" --commit "$feature" --confirmed-by-user
expect_fail 'unknown commit' cli integrate "$task" --base-sha "$trunk" --commit deadbeef --confirmed-by-user
expect_fail 'unreported commit' cli integrate "$task" --base-sha "$trunk" --commit "$trunk" --confirmed-by-user
printf 'wip\n' >"$checkout/wip.txt"
expect_fail 'dirty checkout' cli integrate "$task" --base-sha "$trunk" --commit "$feature" --confirmed-by-user
cli integrate "$task" --plan --commit "$feature" >"$fixture/out" 2>&1 && fail 'plan accepted a dirty checkout'
rm "$checkout/wip.txt"
[[ $before == "$(refs)" ]] && no_branch || fail 'a refused integrate changed refs'

# Base drift: the approved base moved, so the plan must be refreshed first.
printf 'late\n' >"$seed/late.txt"; git -C "$seed" add .; git -C "$seed" commit -qm late; git -C "$seed" push -q origin trunk
git_ fetch -q origin
expect_fail 'drifted base' cli integrate "$task" --base-sha "$trunk" --commit "$feature" --confirmed-by-user
grep -q 'changed since the plan' "$fixture/out" || fail "no drift guidance: $(cat "$fixture/out")"
no_branch && [[ $(git_ rev-parse HEAD) == "$stale" && $(git_ branch --show-current) == architecture-review ]] || fail 'drift refusal changed the checkout'
# Fresh agent work on the new tip, then a refreshed plan.
git -C "$agent" rebase -q origin/trunk >/dev/null
feature=$(git -C "$agent" rev-parse HEAD~1); feature2=$(git -C "$agent" rev-parse HEAD)
jq --arg c1 "$feature" --arg c2 "$feature2" '.commits=[$c1,$c2]' "$task/grok.status.json" >"$task/s.tmp" && mv "$task/s.tmp" "$task/grok.status.json"
trunk=$(git_ rev-parse origin/trunk)
plan=$(cli integrate "$task" --plan --commit "$feature" --commit "$feature2")
[[ $(jq -r '.base.sha' <<<"$plan") == "$trunk" ]] || fail 'refreshed plan kept the old base'

# A conflicting plan restores the checkout and keeps every existing ref and the branch.
git -C "$seed" checkout -q trunk
printf 'conflict-a\n' >"$seed/c.txt"; git -C "$seed" add .; git -C "$seed" commit -qm ca; git -C "$seed" push -q origin trunk
git -C "$agent" checkout -q -b agents/x/set/conflict "$trunk" 2>/dev/null
printf 'conflict-b\n' >"$agent/c.txt"; git -C "$agent" add .; git -C "$agent" commit -qm cb
cb=$(git -C "$agent" rev-parse HEAD); git -C "$agent" checkout -q agents/x/set/grok
git_ fetch -q origin; newtrunk=$(git_ rev-parse origin/trunk)
jq --arg c "$cb" '.commits += [$c]' "$task/grok.status.json" >"$task/s.tmp" && mv "$task/s.tmp" "$task/grok.status.json"
before=$(refs)
expect_fail 'conflicting plan' cli integrate "$task" --base-sha "$newtrunk" --commit "$cb" --confirmed-by-user
grep -q 'conflict' "$fixture/out" || fail "conflict not reported: $(cat "$fixture/out")"
[[ $before == "$(refs)" && -z $(git_ status --porcelain) && $(git_ branch --show-current) == architecture-review ]] || fail 'conflict did not restore the checkout'
[[ $(jq -r '.integration.branch // empty' "$task/state.json") == '' ]] || fail 'conflict recorded an integration'
# Also from a detached checkout: the original commit is restored.
git_ checkout -q --detach "$stale"
expect_fail 'conflicting plan from detached head' cli integrate "$task" --base-sha "$newtrunk" --commit "$cb" --confirmed-by-user
[[ $(git_ rev-parse HEAD) == "$stale" && -z $(git_ branch --show-current) ]] || fail 'detached checkout not restored'
git_ checkout -q architecture-review

# Apply from the stale checkout: the branch starts at the approved base, not at the checkout.
trunk=$newtrunk
git -C "$agent" rebase -q "$trunk" >/dev/null
feature=$(git -C "$agent" rev-parse HEAD~1); feature2=$(git -C "$agent" rev-parse HEAD)
jq --arg c1 "$feature" --arg c2 "$feature2" '.commits=[$c1,$c2]' "$task/grok.status.json" >"$task/s.tmp" && mv "$task/s.tmp" "$task/grok.status.json"
cli integrate "$task" --base-sha "$trunk" --commit "$feature" --commit "$feature2" --confirmed-by-user >"$fixture/out"
branch=integration/set/t1
[[ $(git_ branch --show-current) == $branch ]] || fail 'checkout is not on the integration branch'
[[ $(git_ merge-base HEAD "$trunk") == "$trunk" && $(git_ rev-list --count "$trunk..HEAD") == 2 ]] || fail 'branch does not start at the approved base with only the selected commits'
git_ merge-base --is-ancestor architecture-review HEAD && fail 'stale checkout history leaked into the integration branch'
[[ $(git_ rev-parse architecture-review) == "$stale" ]] || fail 'original branch moved'
head=$(git_ rev-parse HEAD)
jq -e --arg head "$head" --arg trunk "$trunk" --arg stale "$stale" --arg tree "$(git_ rev-parse HEAD^{tree})" \
  '.integration | .head == $head and .base_sha == $trunk and .base_ref == "origin/trunk" and .original_branch == "architecture-review" and .original_sha == $stale and .tree == $tree and (.selected_commits | length) == 2' "$task/state.json" >/dev/null || fail "recorded artifact: $(jq -c .integration "$task/state.json")"
expect_fail 'second apply' cli integrate "$task" --base-sha "$trunk" --commit "$feature" --confirmed-by-user
ids=$(cli next "$task" | jq -r '[.actions[].id] | join(",")')
[[ $ids == record-integration ]] || fail "next after apply advertised: $ids"

# Evidence authorizes only this checkout, branch and exact artifact.
git_ checkout -q architecture-review
expect_fail 'evidence from another branch' cli advance "$task" record-integration --evidence ok --confirmed-by-user
git_ checkout -q $branch
printf 'x\n' >"$checkout/extra.txt"; git_ add extra.txt; git_ commit -qm extra
expect_fail 'evidence for a moved artifact' cli advance "$task" record-integration --evidence ok --confirmed-by-user
grep -q 'recorded artifact' "$fixture/out" || fail "no artifact guidance: $(cat "$fixture/out")"
git_ reset -q --hard "$head"
expect_fail 'evidence without text' cli advance "$task" record-integration --evidence ' ' --confirmed-by-user
cli advance "$task" record-integration --evidence 'make check green' --confirmed-by-user >/dev/null
[[ $(jq -r .status "$task/state.json") == awaiting_pr ]] || fail 'record-integration did not advance'
grep -q "$head" "$task/integration-result.md" || fail 'evidence does not name the artifact'

# Publication re-checks the same artifact (it stops before any network use).
cli advance "$task" prepare-pr --title T --confirmed-by-user >/dev/null
cli advance "$task" approve-pr --confirmed-by-user >/dev/null
git_ checkout -q architecture-review
expect_fail 'publish from another branch' cli publish "$task" --confirmed-by-user
grep -q 'recorded integration branch' "$fixture/out" || fail "publish branch guidance: $(cat "$fixture/out")"
git_ checkout -q $branch
printf 'y\n' >"$checkout/extra2.txt"; git_ add extra2.txt; git_ commit -qm extra2
expect_fail 'publish a moved artifact' cli publish "$task" --confirmed-by-user
grep -q 'validated artifact' "$fixture/out" || fail "publish artifact guidance: $(cat "$fixture/out")"
git_ reset -q --hard "$head"

# Legacy tasks: the checkout-head base is available only when asked for, and is labelled.
git_ checkout -q architecture-review; git_ branch -q -D $branch
write_state integration_ready
cli integrate "$task" --from-current-checkout --commit "$feature" --confirmed-by-user >/dev/null
[[ $(jq -r '.integration.base_source + " " + .integration.base_sha' "$task/state.json") == "checkout-head $stale" ]] || fail 'legacy base not labelled'
git_ checkout -q architecture-review; git_ branch -q -D $branch
# A legacy integration record (no head) still records evidence, and says so.
jq '.integration={branch:"integration/set/t1"} | .status="integration_ready"' "$task/state.json" >"$task/s.tmp" && mv "$task/s.tmp" "$task/state.json"
git_ checkout -q -b $branch
cli advance "$task" record-integration --evidence legacy --confirmed-by-user >/dev/null
grep -q 'legacy integration' "$task/integration-result.md" || fail 'legacy evidence not labelled'
printf 'ok - integration starts from the approved base and evidence is bound to the exact artifact\n'
