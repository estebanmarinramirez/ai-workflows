#!/bin/bash

set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
failures=0

check() { if "$@"; then printf 'ok - %s\n' "$*"; else printf 'not ok - %s\n' "$*"; failures=$((failures+1)); fi; }

check bash -n "$root/bin/agent-workspaces" "$root/lib/core.sh" "$root/packaging/install" "$root/packaging/migrate" "$root/packaging/rollback"
check bash -n "$root"/compat/bin/*
for file in "$root/config/config.json" "$root/config/providers"/*.json "$root/schemas"/*.json; do check jq -e . "$file" >/dev/null; done
check jq -e '.seams.general.paths == ["**"] and (.seams.shared.paths | index("Cargo.lock") != null)' "$root/config/config.json"

fixture=$(mktemp -d)
trap 'rm -rf "$fixture"' EXIT
mkdir -p "$fixture/config/agent-workspaces/providers" "$fixture/data/agent-workspaces/repo-hash/set/.coordination/t1"
cp "$root/config/providers"/*.json "$fixture/config/agent-workspaces/providers/"
cp "$root/config/config.json" "$fixture/config/agent-workspaces/config.json"
export HOME="$fixture/home" XDG_CONFIG_HOME="$fixture/config" XDG_DATA_HOME="$fixture/data"
source "$root/lib/core.sh"

origin="$fixture/origin.git"
repository="$fixture/repository"
git init --bare --initial-branch=main "$origin" >/dev/null
git init --initial-branch=main "$repository" >/dev/null
git -C "$repository" config user.name fixture
git -C "$repository" config user.email fixture@example.invalid
git -C "$repository" commit --allow-empty -m initial >/dev/null
git -C "$repository" remote add origin "$origin"
git -C "$repository" push -u origin main >/dev/null
git -C "$origin" symbolic-ref HEAD refs/heads/main
git -C "$repository" fetch origin >/dev/null
[[ $(aw_origin_base "$repository") == origin/main ]] || { printf 'not ok - origin default branch\n'; failures=$((failures+1)); }

jq -n '{schema_version:2,workspace_id:"x:set",repository:"/tmp",set:"set",profile:"trusted",providers:["claude","codex","grok"]}' \
  >"$fixture/data/agent-workspaces/repo-hash/set/workspace.json"

trusted_codex=$(aw_provider_command codex fresh trusted)
[[ $trusted_codex == *"--approve-for-me"* && $trusted_codex != *"--sandbox"* ]] || { printf 'not ok - trusted codex profile\n'; failures=$((failures+1)); }
[[ $(aw_provider_command claude fresh trusted) != *bypassPermissions* ]] || { printf 'not ok - trusted claude is not bypass\n'; failures=$((failures+1)); }
[[ $(aw_provider_command grok fresh yolo) == *bypassPermissions* ]] || { printf 'not ok - explicit yolo profile\n'; failures=$((failures+1)); }

task="$fixture/data/agent-workspaces/repo-hash/set/.coordination/t1"
for role in claude codex grok; do
  jq -n --arg role "$role" --arg file "$task/$role.status.json" '{($role):{status_json:$file,worktree:"/tmp"}}' >"$task/$role.role"
  jq -n --arg role "$role" '{schema_version:1,task_id:"t1",role:$role,state:"completed",updated_at:"now",evidence:[],commits:[],changed_files:[],blockers:[]}' >"$task/$role.status.json"
done
roles=$(jq -s 'add' "$task"/*.role)
jq -n --argjson roles "$roles" '{schema_version:2,id:"t1",workspace_id:"x:set",repository:"/tmp",stage:"execute",status:"active",roles:$roles,gates:{},transitions:[]}' >"$task/state.json"
jq '.state="blocked"' "$task/grok.status.json" >"$task/grok.tmp" && mv "$task/grok.tmp" "$task/grok.status.json"
[[ $(aw_task_refresh "$task") == blocked ]] || { printf 'not ok - blocked role blocks task\n'; failures=$((failures+1)); }

if AW_LIB="$root/lib/core.sh" "$root/bin/agent-workspaces" status --task "$task" --role grok --state blocked >/dev/null 2>&1; then
  printf 'not ok - blocker evidence is required\n'; failures=$((failures+1))
else
  printf 'ok - blocker evidence is required\n'
fi
AW_LIB="$root/lib/core.sh" "$root/bin/agent-workspaces" status --task "$task" --role grok --state blocked --blocker 'missing fixture' --summary 'blocked' >/dev/null
AW_LIB="$root/lib/core.sh" "$root/bin/agent-workspaces" snapshot x:set --write >/dev/null
[[ -s $fixture/data/agent-workspaces/repo-hash/set/.orchestrator/snapshot.md ]] || { printf 'not ok - orchestrator snapshot\n'; failures=$((failures+1)); }
signature_one=$(sed '/^Updated:/d' "$fixture/data/agent-workspaces/repo-hash/set/.orchestrator/snapshot.md" | sha256sum | awk '{print $1}')
AW_LIB="$root/lib/core.sh" "$root/bin/agent-workspaces" snapshot x:set --write >/dev/null
signature_two=$(sed '/^Updated:/d' "$fixture/data/agent-workspaces/repo-hash/set/.orchestrator/snapshot.md" | sha256sum | awk '{print $1}')
[[ $signature_one == "$signature_two" ]] || { printf 'not ok - timestamp-free event signature\n'; failures=$((failures+1)); }

jq '.status="awaiting_pr" | .gates.integration_approved=true' "$task/state.json" >"$task/state.tmp" && mv "$task/state.tmp" "$task/state.json"
printf '# Integration result\n\nvalidated\n' >"$task/integration-result.md"
[[ $(AW_LIB="$root/lib/core.sh" "$root/bin/agent-workspaces" next "$task" | jq -r '.actions[0].id') == prepare-pr ]] || { printf 'not ok - next action contract\n'; failures=$((failures+1)); }
if AW_LIB="$root/lib/core.sh" "$root/bin/agent-workspaces" advance "$task" prepare-pr --title test >/dev/null 2>&1; then
  printf 'not ok - human confirmation required\n'; failures=$((failures+1))
else
  printf 'ok - human confirmation required\n'
fi
AW_LIB="$root/lib/core.sh" "$root/bin/agent-workspaces" advance "$task" prepare-pr --title 'Test PR' --confirmed-by-user >/dev/null
[[ $(jq -r '.status' "$task/state.json") == awaiting_pr_review ]] || { printf 'not ok - prepare PR transition\n'; failures=$((failures+1)); }
AW_LIB="$root/lib/core.sh" "$root/bin/agent-workspaces" advance "$task" approve-pr --confirmed-by-user >/dev/null
[[ $(jq -r '.status' "$task/state.json") == ready_for_pr ]] || { printf 'not ok - approve PR transition\n'; failures=$((failures+1)); }
AW_LIB="$root/lib/core.sh" "$root/bin/agent-workspaces" attention x:set >/dev/null
[[ -s $fixture/data/agent-workspaces/repo-hash/set/.orchestrator/attention.md ]] || { printf 'not ok - human attention card\n'; failures=$((failures+1)); }
if AW_LIB="$root/lib/core.sh" "$root/bin/agent-workspaces" integrate "$task" --commit deadbeef >/dev/null 2>&1; then
  printf 'not ok - integration confirmation required\n'; failures=$((failures+1))
else
  printf 'ok - integration confirmation required\n'
fi

mkdir -p "$fixture/bin"
printf '%s\n' '#!/bin/bash' 'printf '\''%s\n'\'' '\''{"number":13,"url":"https://example.invalid/pr/13","state":"MERGED","mergedAt":"2026-08-19T12:00:00Z","mergeCommit":{"oid":"83fab97c"},"statusCheckRollup":[{"conclusion":"SUCCESS"}]}'\''' >"$fixture/bin/gh"
chmod +x "$fixture/bin/gh"
PATH="$fixture/bin:$PATH" AW_LIB="$root/lib/core.sh" "$root/bin/agent-workspaces" reconcile-pr "$task" --pr 13 >/dev/null
[[ $(jq -r '.status + ":" + .pr.state + ":" + (.pr.number|tostring)' "$task/state.json") == completed:MERGED:13 ]] || { printf 'not ok - merged PR reconciliation\n'; failures=$((failures+1)); }

# Historical and gated workflows are records, not live write leases. The
# dispatcher itself covers active seam conflicts; keep this status contract
# explicit so orchestration instructions cannot reinterpret stale records.
check jq -e '.status == "completed" and .stage == "complete"' "$task/state.json"

printf '%s test failure(s)\n' "$failures"
exit "$failures"
