#!/usr/bin/env python3
"""Handover regression tests: no real tmux server or agent is touched."""
import argparse
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch
from datetime import datetime, timedelta, timezone

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
spec = importlib.util.spec_from_file_location('assignments', ROOT / 'lib/assignments.py')
a = importlib.util.module_from_spec(spec)
spec.loader.exec_module(a)


class Handover(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory()
        self.addCleanup(self.temporary.cleanup)
        base = Path(self.temporary.name)
        self.root = base / 'data/agent-workspaces/repo/set'
        self.root.mkdir(parents=True)
        a.atomic(self.root / 'workspace.json', {'workspace_id': 'w:set', 'profile': 'safe'})
        self.worktree = self.root / 'codex'
        self.worktree.mkdir()
        subprocess.run(['git', 'init', '-q', str(self.worktree)], check=True)
        subprocess.run(['git', '-C', str(self.worktree), '-c', 'user.name=Test', '-c', 'user.email=test@example.invalid', 'commit', '--allow-empty', '-qm', 'checkpoint'], check=True)
        self.task = self.root / '.coordination/t1'
        a.atomic(self.task / 'state.json', {'workspace_id': 'w:set', 'id': 't1', 'lead': 'codex', 'status': 'active',
                 'roles': {'codex': {'worktree': str(self.worktree), 'state': 'in_progress', 'status_json': str(self.task / 'codex.status.json')}}, 'gates': {}, 'transitions': []})
        config = base / 'config/agent-workspaces'
        (config / 'providers').mkdir(parents=True)
        shutil.copy(ROOT / 'config/config.json', config / 'config.json')
        for provider in (ROOT / 'config/providers').glob('*.json'):
            shutil.copy(provider, config / 'providers' / provider.name)
        self.env = patch.dict(os.environ, XDG_CONFIG_HOME=str(base / 'config'), XDG_DATA_HOME=str(base / 'data'), CODEX_HOME=str(base / 'codex-cache'), GROK_HOME=str(base / 'grok-cache'), AW_LIB=str(ROOT / 'lib/core.sh'), AW_WORKSPACE_ID='')
        self.env.start()
        self.addCleanup(self.env.stop)
        self.cli = str(ROOT / 'bin/agent-workspaces')
        self.store = a.Assignments(self.root, self.cli)
        self.providers = {'codex': 'codex', 'orchestrator': 'claude'}
        self.command = 'codex'
        self.children = False
        self.generation = ''
        self.launches = []
        self.fail_launch = False
        original_run = a.run
        def fake_run(args):
            if args[0] != 'tmux':
                return original_run(args)
            action = args[1]
            if action == 'list-sessions':
                return '\n'.join(f's-{slot}\t{slot}\tw:set\t{provider}' for slot, provider in self.providers.items())
            if action == 'display-message':
                return str(self.worktree)
            if action == 'list-panes':
                return f'%1\t99999\t{self.command}'
            if action == 'show-option':
                return 'safe' if args[-1] == '@aw_profile' else self.generation
            if action == 'set-option':
                session = args[args.index('-t') + 1]
                if args[-2] == '@aw_provider':
                    self.providers[session.removeprefix('s-')] = args[-1]
                if args[-2] == '@aw_handover_id':
                    self.generation = args[-1]
                return ''
            if action == 'respawn-pane':
                if self.fail_launch:
                    raise a.ChangeError('Simulated launch failure')
                self.launches.append(args)
                self.command = 'claude'
                return ''
            self.fail(f'Unexpected tmux operation {args}')
        self.patch_run = patch.object(a, 'run', side_effect=fake_run)
        self.patch_run.start()
        self.addCleanup(self.patch_run.stop)
        original_subprocess_run = subprocess.run
        def fake_subprocess_run(args, **kwargs):
            if args[0] == 'pgrep':
                return subprocess.CompletedProcess(args, 0 if self.children else 1, '', '')
            return original_subprocess_run(args, **kwargs)
        process_patch = patch.object(a.subprocess, 'run', side_effect=fake_subprocess_run)
        process_patch.start()
        self.addCleanup(process_patch.stop)
        available = patch.object(a.shutil, 'which', return_value='/fixture/agent')
        available.start()
        self.addCleanup(available.stop)
        self.note = base / 'handover.md'
        self.note.write_text('Objective: implement feature. Completed: reproduction. Remaining: fix. Validation: regression recorded. Blockers: none.')

    def request(self, **overrides):
        values = dict(role='lead', provider='claude', model='chosen-model', effort='high', when='checkpoint', task=str(self.task))
        values.update(overrides)
        return self.store.select(argparse.Namespace(**values))

    def ready(self, **overrides):
        record = self.request(**overrides)
        return self.store.checkpoint(record['id'], self.note)

    def test_selection_is_durable_and_does_not_transfer_ownership(self):
        record = self.request()
        self.assertEqual(record['slot'], 'codex')
        self.assertEqual(self.store.load()['active'], {})
        self.assertEqual(self.store.load()['requests'][record['id']]['phase'], 'requested')
        self.assertEqual(self.launches, [])
        with self.assertRaises(a.ChangeError):
            self.request()

    def test_dirty_checkpoint_refused(self):
        record = self.request()
        (self.worktree / 'unsaved.txt').write_text('work')
        with self.assertRaises(a.ChangeError):
            self.store.checkpoint(record['id'], self.note)
        self.assertEqual(self.store.load()['requests'][record['id']]['phase'], 'requested')

    def test_running_agent_and_background_jobs_are_never_killed(self):
        record = self.ready()
        with self.assertRaises(a.ChangeError):
            self.store.apply(record['id'])
        self.command = 'bash'
        self.children = True
        with self.assertRaises(a.ChangeError):
            self.store.apply(record['id'])
        self.assertEqual(self.launches, [])

    def test_checkpoint_freezes_task_and_gate(self):
        self.ready()
        result = subprocess.run([self.cli, 'status', '--task', str(self.task), '--role', 'codex', '--state', 'in_progress'], capture_output=True, text=True)
        self.assertNotEqual(result.returncode, 0)
        self.assertIn('paused for handover', result.stderr)
        result = subprocess.check_output([self.cli, 'next', str(self.task)], text=True)
        self.assertEqual(json.loads(result)['actions'][0]['id'], 'complete-handover')

    def test_successor_ack_is_required_and_preserves_slot_worktree_and_permissions(self):
        record = self.ready()
        self.command = 'bash'
        self.store.apply(record['id'])
        self.assertEqual(self.store.load()['active'], {})
        launch = self.launches[0]
        self.assertIn(str(self.worktree), launch)
        self.assertIn("'--permission-mode' 'manual'", launch[-1])
        self.assertIn("'--model' 'chosen-model'", launch[-1])
        self.assertIn('accept ' + record['id'], launch[-1])
        with self.assertRaises(a.ChangeError):
            self.store.accept(record['id'])
        with patch.dict(os.environ, AW_HANDOVER_ID=record['id']):
            self.store.accept(record['id'])
        state = self.store.load()
        self.assertEqual(state['default_lead'], 'codex')
        self.assertEqual(state['active']['codex']['provider'], 'claude')
        self.assertEqual(a.read(self.task / 'state.json')['lead'], 'codex')
        command = subprocess.check_output([self.cli, 'provider-command', 'codex', 'fresh', 'safe', '', '', 'codex', 'w:set'], text=True)
        self.assertTrue(command.startswith("'claude'"), command)
        self.assertIn("'chosen-model'", command)
        self.assertEqual(self.store.load()['requests'][record['id']]['phase'], 'active')

    def test_next_task_waits_for_existing_work(self):
        record = self.request(when='next-task')
        with self.assertRaises(a.ChangeError):
            self.store.checkpoint(record['id'], self.note)
        state = a.read(self.task / 'state.json')
        state['status'] = 'completed'
        a.atomic(self.task / 'state.json', state)
        self.assertEqual(self.store.checkpoint(record['id'], self.note)['phase'], 'ready')

    def test_orchestrator_next_task_waits_but_checkpoint_can_happen_between_turns(self):
        record = self.request(role='orchestrator', task=None, when='next-task')
        with self.assertRaises(a.ChangeError):
            self.store.checkpoint(record['id'], self.note)
        self.store.cancel(record['id'])
        record = self.ready(role='orchestrator', task=None)
        self.assertEqual(record['phase'], 'ready')

    def test_failure_can_be_retried_only_after_process_exit(self):
        record = self.ready()
        self.command = 'bash'
        self.fail_launch = True
        with self.assertRaises(a.ChangeError):
            self.store.apply(record['id'])
        self.assertEqual(self.store.load()['requests'][record['id']]['phase'], 'launching')
        self.fail_launch = False
        self.store.apply(record['id'])
        with self.assertRaises(a.ChangeError):
            self.store.apply(record['id'])
        self.assertEqual(len(self.launches), 1)

    def test_other_task_and_changed_checkpoint_are_protected(self):
        record = self.request()
        other = self.root / '.coordination/t2/state.json'
        a.atomic(other, a.read(self.task / 'state.json'))
        with self.assertRaises(a.ChangeError):
            self.store.checkpoint(record['id'], self.note)
        other.unlink()
        self.store.checkpoint(record['id'], self.note)
        self.command = 'bash'
        (self.worktree / 'late.txt').write_text('new changes')
        with self.assertRaises(a.ChangeError):
            self.store.apply(record['id'])
        self.assertEqual(self.launches, [])

    def test_cancel_before_launch_unfreezes_without_switch(self):
        record = self.ready()
        self.store.cancel(record['id'])
        self.assertEqual(self.store.load()['requests'][record['id']]['phase'], 'cancelled')
        self.assertEqual(self.store.load()['active'], {})
        self.assertEqual(self.launches, [])

    def test_reconcile_only_launches_checkpointed_stopped_sessions(self):
        record = self.request()
        self.assertEqual(self.store.reconcile(), [])
        self.store.checkpoint(record['id'], self.note)
        self.assertEqual(self.store.reconcile(), [])
        self.command = 'bash'
        self.assertEqual(len(self.store.reconcile()), 1)
        self.assertEqual(self.store.reconcile(), [])

    def test_failed_successor_can_be_cancelled_after_exit(self):
        record = self.ready()
        self.command = 'bash'
        self.store.apply(record['id'])
        with self.assertRaises(a.ChangeError):
            self.store.cancel(record['id'])
        self.command = 'bash'
        self.store.cancel(record['id'])
        self.assertEqual(self.providers['codex'], 'codex')
        self.assertEqual(self.store.load()['requests'][record['id']]['phase'], 'cancelled')

    def test_foreign_task_rejected(self):
        with self.assertRaises(a.ChangeError):
            self.request(task='/tmp/foreign-task')

    def test_new_efforts_and_incompatible_pairs(self):
        for provider, model, effort in [('claude', 'opus', 'max'), ('claude', 'fable', 'xhigh'),
                                        ('codex', 'gpt-6.1-sol', 'ultra'), ('grok', 'grok-4.6', 'xhigh')]:
            record = self.request(provider=provider, model=model, effort=effort)
            self.store.cancel(record['id'])
        for provider, model, effort in [('codex', 'gpt-6-luna', 'ultra'), ('grok', 'grok-4.5', 'xhigh'),
                                        ('claude', 'haiku', 'high'), ('claude', 'opus', 'ultra')]:
            with self.assertRaises(a.ChangeError):
                self.request(provider=provider, model=model, effort=effort)

    def test_disabled_after_checkpoint_cannot_launch_or_change_ownership(self):
        record = self.ready()
        self.command = 'bash'
        path = self.store.config_root / 'config.json'
        policy = a.read(path)
        policy['provider_overrides'] = {'claude': {'enabled': False}}
        a.atomic(path, policy)
        with self.assertRaises(a.ChangeError):
            self.store.apply(record['id'])
        self.assertEqual(self.store.load()['requests'][record['id']]['phase'], 'ready')
        self.assertEqual(self.providers['codex'], 'codex')
        self.assertEqual(self.launches, [])

    def test_orchestrator_handover_keeps_coordination_access_and_remote_control(self):
        record = self.ready(role='orchestrator', task=None)
        self.command = 'bash'
        self.store.apply(record['id'])
        command = self.launches[-1][-1]
        self.assertIn('--add-dir ' + str(self.root / '.coordination'), command)
        self.assertIn('--remote-control ', command)

    def automatic_ready(self):
        record = self.ready()
        state = self.store.load()
        state['requests'][record['id']].update(source='routing', routing={
            'effort_mode':'fixed','intent_revision':0,'task':str(self.task),'difficulty':'standard','task_revision':0})
        self.store.save(state)
        self.command = 'bash'
        self.usage = self.root.parent.parent.parent.parent/'state/omarchy/agents/usage'
        self.usage.mkdir(parents=True, exist_ok=True)
        current = datetime.now(timezone.utc)
        a.atomic(self.usage/'claude.json', {'id':'claude','ready':True,'updatedAt':current.isoformat(),
                    'limits':[{'percent':.2,'resetsAt':(current+timedelta(hours=1)).isoformat()}]})
        return record

    def test_automatic_launch_rechecks_capacity_and_preferences(self):
        record = self.automatic_ready()
        with patch.dict(os.environ, XDG_STATE_HOME=str(self.usage.parents[2])):
            quota = a.read(self.usage/'claude.json')
            quota['limits'][0]['percent'] = .99
            a.atomic(self.usage/'claude.json',quota)
            with self.assertRaises(a.ChangeError): self.store.apply(record['id'])
            self.assertEqual(self.launches,[])
            quota['limits'][0]['percent'] = .2
            a.atomic(self.usage/'claude.json',quota)
            a.atomic(self.root/'workspace.json',{'workspace_id':'w:set','routing':{'effort_mode':'auto'}})
            with self.assertRaises(a.ChangeError): self.store.apply(record['id'])
            self.assertEqual(self.launches,[])
            a.atomic(self.root/'workspace.json',{'workspace_id':'w:set'})
            self.store.apply(record['id'])
            self.assertEqual(len(self.launches),1)
            with patch.dict(os.environ, AW_HANDOVER_ID=record['id']): self.store.accept(record['id'])
            self.assertEqual(self.store.load()['active']['codex']['source'],'routing')

    def test_automatic_launch_rechecks_current_model_allowlist(self):
        record = self.automatic_ready()
        path = self.store.config_root / 'config.json'
        policy = a.read(path)
        with patch.dict(os.environ, XDG_STATE_HOME=str(self.usage.parents[2])):
            for allowed in ([], ['another-model']):
                policy['routing']['allowed_models'] = {'claude': allowed}
                a.atomic(path, policy)
                with self.assertRaisesRegex(a.ChangeError, 'no longer allowed'):
                    self.store.apply(record['id'])
                self.assertEqual(self.launches, [])
                self.assertEqual(self.store.load()['requests'][record['id']]['phase'], 'ready')
            policy['routing']['allowed_models'] = {'claude': ['chosen-model']}
            a.atomic(path, policy)
            self.store.apply(record['id'])
            self.assertEqual(len(self.launches), 1)

    def test_automatic_launch_rechecks_task_intent_and_completion(self):
        record = self.automatic_ready()
        original = a.read(self.task / 'state.json')
        with patch.dict(os.environ, XDG_STATE_HOME=str(self.usage.parents[2])):
            for changes in ({'routing': {'difficulty': 'complex'}},
                            {'routing': {'difficulty': 'standard', 'revision': 2}},
                            {'status': 'completed'}):
                a.atomic(self.task / 'state.json', dict(original, **changes))
                with self.assertRaisesRegex(a.ChangeError, 'Task routing intent changed'):
                    self.store.apply(record['id'])
                self.assertEqual(self.launches, [])
                self.assertEqual(self.store.load()['requests'][record['id']]['phase'], 'ready')
            a.atomic(self.task / 'state.json', original)
            self.store.apply(record['id'])
            self.assertEqual(len(self.launches), 1)

    def test_reviewer_handover_preserves_lead_and_requires_clean_worktree(self):
        state = a.read(self.task/'state.json')
        state['lead']='claude'
        state['roles']['claude']={'worktree':str(self.root/'claude'),'state':'completed'}
        a.atomic(self.task/'state.json',state)
        record=self.request(role='worker',slot='codex')
        (self.worktree/'dirty').write_text('unsaved')
        with self.assertRaises(a.ChangeError): self.store.checkpoint(record['id'],self.note)
        (self.worktree/'dirty').unlink()
        self.store.checkpoint(record['id'],self.note)
        self.command='bash'; self.store.apply(record['id'])
        with patch.dict(os.environ, AW_HANDOVER_ID=record['id']): self.store.accept(record['id'])
        self.assertIsNone(self.store.load()['default_lead'])
        self.assertEqual(a.read(self.task/'state.json')['lead'],'claude')


unittest.main()
