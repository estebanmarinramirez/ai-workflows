#!/usr/bin/env python3
"""Budget decisions, atomic leases and expiry, without paid provider calls."""
import copy
from datetime import datetime,timedelta,timezone
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time
import unittest
from unittest.mock import patch
sys.dont_write_bytecode=True
ROOT=Path(__file__).resolve().parents[1];sys.path.insert(0,str(ROOT/'lib'))
import budget as b


class Budget(unittest.TestCase):
    def setUp(self):
        self.temp=tempfile.TemporaryDirectory();self.addCleanup(self.temp.cleanup)
        self.base=Path(self.temp.name)
        env=patch.dict(os.environ,XDG_STATE_HOME=str(self.base/'state'),XDG_CONFIG_HOME=str(self.base/'config'),XDG_DATA_HOME=str(self.base/'data'))
        env.start();self.addCleanup(env.stop)
        self.config=json.loads((ROOT/'config/config.json').read_text());self.config['budget']['enabled']=True
        folder=self.base/'config/agent-workspaces';folder.mkdir(parents=True)
        import shutil
        shutil.copytree(ROOT/'config/providers',folder/'providers')
        self.save();self.quota(.2)

    def save(self):
        (self.base/'config/agent-workspaces/config.json').write_text(json.dumps(self.config))
    def quota(self,used,**changes):
        now=datetime.now(timezone.utc)
        obj={'id':'codex','ready':True,'updatedAt':now.isoformat(),'limits':[{'percent':used,'resetsAt':(now+timedelta(hours=3)).isoformat()}]}
        obj.update(changes)
        path=self.base/'state/omarchy/agents/usage';path.mkdir(parents=True,exist_ok=True)
        (path/'codex.json').write_text(json.dumps(obj))

    def test_separate_reserve_and_unknown_fail_closed(self):
        self.quota(.6);b.check(self.config,'codex')
        with self.assertRaisesRegex(ValueError,'protected'):b.check(self.config,'codex','experiment')
        self.quota(.8)
        with self.assertRaisesRegex(ValueError,'protected'):b.check(self.config,'codex')
        self.quota(.1,ready=False)
        with self.assertRaisesRegex(ValueError,'fresh'):b.check(self.config,'codex')

    def test_attempts_shared_across_runs_and_failures_are_charged(self):
        with self.assertRaises(RuntimeError):
            with b.admission(self.config,'codex','experiment'):raise RuntimeError('provider failed')
        with b.admission(self.config,'codex','experiment'):pass
        with self.assertRaisesRegex(ValueError,'24-hour'):
            with b.admission(self.config,'codex','experiment'):pass

    def test_experiments_wait_behind_managed_work(self):
        with b.admission(self.config,'codex','managed'):
            with self.assertRaisesRegex(ValueError,'waits behind'):
                with b.admission(self.config,'codex','experiment'):pass
        with b.admission(self.config,'codex','experiment'):pass

    def test_cross_process_concurrency_is_atomic(self):
        code='import budget; c,_=budget.configuration();\nwith budget.admission(c,"codex","experiment"): pass'
        with b.admission(self.config,'codex','experiment'):
            result=subprocess.run([sys.executable,'-c',code],env={**os.environ,'PYTHONPATH':str(ROOT/'lib')},capture_output=True,text=True)
            self.assertNotEqual(result.returncode,0);self.assertIn('another measured experiment',result.stderr)
        db=b.database()
        try:self.assertEqual(db.execute("select count(*) from claims where purpose='experiment'").fetchone()[0],1)
        finally:db.close()

    def test_boost_expiry_and_global_time_allowance(self):
        with patch('budget.time.time',return_value=1000):
            grant=b.grant(self.config,'w','codex','gpt-6-astra','high',10)
            self.assertEqual(b.target(self.config,'codex','standard',workspace='w',lead=True)['model'],'gpt-6-astra')
            with self.assertRaisesRegex(ValueError,'another'):b.grant(self.config,'other','codex','gpt-6-astra','high',10)
        self.assertEqual(b.target(self.config,'codex','standard',workspace='w',lead=True,now=grant['expires']+1)['model'],'gpt-6.1-sol')
        with patch('budget.time.time',return_value=1700):b.grant(self.config,'w','codex','gpt-6-astra','high',10)
        with patch('budget.time.time',return_value=2400),self.assertRaisesRegex(ValueError,'allowance'):b.grant(self.config,'w','codex','gpt-6-astra','high',10)

    def test_pressure_suppresses_boost_and_balances_effort(self):
        b.grant(self.config,'w','codex','gpt-6-astra','high',10)
        self.assertEqual(b.target(self.config,'codex','complex',True,'w',True),{'provider':'codex','model':'gpt-6.1-sol','effort':'medium'})
        self.assertEqual(b.target(self.config,'codex','simple')['model'],'gpt-6-luna')

    def test_expensive_experiments_and_long_timeouts_rejected(self):
        with self.assertRaises(ValueError):b.check_experiment(self.config,{'provider':'codex','model':'gpt-6-astra','effort':'high'},30)
        with self.assertRaises(ValueError):b.check_experiment(self.config,{'provider':'codex','model':'gpt-6-luna','effort':'low'},121)
        b.check_experiment(self.config,{'provider':'codex','model':'gpt-6-luna','effort':'low'},120)

    def test_disabled_preserves_existing_behavior(self):
        self.config['budget']['enabled']=False;self.quota(.99)
        with b.admission(self.config,'codex','managed'):pass
        self.assertEqual(b.reserve(self.config),0)
        self.assertIsNone(b.boost(self.config,'w','codex'))

    def test_launch_denial_never_executes_child(self):
        self.quota(.9)
        marker=self.base/'should-not-exist'
        result=subprocess.run([sys.executable,str(ROOT/'lib/budget.py'),'launch','codex','--',sys.executable,'-c',f'open({str(marker)!r},"w").write("bad")'],capture_output=True,text=True)
        self.assertNotEqual(result.returncode,0);self.assertFalse(marker.exists())

    def test_preexisting_managed_panes_take_priority(self):
        with patch.object(b,'observed_sessions',return_value=1),self.assertRaisesRegex(ValueError,'waits behind'):
            with b.admission(self.config,'codex','experiment'):pass

    def test_account_aliases_share_concurrency(self):
        self.config['routing']['account_pools']={'codex':'shared','claude':'shared'}
        self.config['budget']['managed_concurrency_per_pool']=1
        self.config['providers']=['codex']
        with b.admission(self.config,'codex','managed'):
            with self.assertRaisesRegex(ValueError,'concurrency'):
                with b.admission(self.config,'claude','managed'):pass

    def test_usage_timer_refreshes_native_limits_only_when_enabled(self):
        binaries=self.base/'bin';binaries.mkdir()
        codex=binaries/'codex';codex.write_text('#!/bin/sh\nexit 1\n');codex.chmod(0o755)
        native=binaries/'omarchy';native.write_text('#!/bin/sh\nprintf "%s\\n" "$*" > "$AW_TEST_NATIVE_LOG"\n');native.chmod(0o755)
        collector=binaries/'fixture';collector.write_text('#!/usr/bin/env python3\nprint('+repr(json.dumps({'schemaVersion':1,'id':'fixture','name':'Fixture','ready':True,'limits':[],'updatedAt':'2026-10-11T00:00:00Z'}))+')\n');collector.chmod(0o755)
        logfile=self.base/'native.log'
        env={**os.environ,'PATH':str(binaries)+os.pathsep+os.environ['PATH'],'AW_TEST_NATIVE_LOG':str(logfile),
             'AW_USAGE_LIB':str(ROOT/'lib/usage.sh'),'AW_USAGE_COLLECTORS':'fixture='+str(collector)}
        result=subprocess.run([str(ROOT/'compat/bin/agent-workspaces-usage-update')],env=env,capture_output=True,text=True)
        self.assertEqual(result.returncode,0,result.stderr)
        self.assertEqual(logfile.read_text().strip(),'agent usage-update --limits-only codex claude')
        logfile.unlink();self.config['budget']['enabled']=False;self.save()
        result=subprocess.run([str(ROOT/'compat/bin/agent-workspaces-usage-update')],env=env,capture_output=True,text=True)
        self.assertEqual(result.returncode,0,result.stderr);self.assertFalse(logfile.exists())

    def test_invalid_existing_configuration_never_disables_gate(self):
        path=self.base/'config/agent-workspaces/config.json'
        for value in ('{broken', '[]', 'null'):
            path.write_text(value)
            with self.assertRaises(ValueError):b.configuration()

    def test_experiment_counts_its_invoking_managed_pane(self):
        folder=self.base/'data/agent-workspaces/project/workspace';folder.mkdir(parents=True)
        (folder/'workspace.json').write_text(json.dumps({'workspace_id':'w'}))
        output='w\tcodex\tcodex\t%1\t\n'
        with patch.dict(os.environ,TMUX_PANE='%1'),patch.object(b.subprocess,'run',return_value=subprocess.CompletedProcess([],0,output,'')):
            with self.assertRaisesRegex(ValueError,'waits behind'):
                with b.admission(self.config,'codex','experiment'):pass
            # The CLI replacement itself must not double-count its launching pane.
            self.assertEqual(b.observed_sessions(self.config,'codex',exclude_pane='%1'),0)
        db=b.database()
        try:self.assertEqual(db.execute('SELECT count(*) FROM claims').fetchone()[0],0)
        finally:db.close()

    def test_unknown_interactive_launch_opens_but_automated_work_blocks(self):
        self.quota(.1,limits=[])
        for purpose in ('managed','experiment'):
            with self.assertRaisesRegex(ValueError,'fresh'):
                with b.admission(self.config,'codex',purpose):pass
        marker=self.base/'opened'
        command=[sys.executable,str(ROOT/'lib/budget.py'),'launch','codex','--',sys.executable,'-c',f'open({str(marker)!r},"w").write("opened")']
        result=subprocess.run(command,capture_output=True,text=True)
        self.assertEqual(result.returncode,0,result.stderr);self.assertTrue(marker.exists())
        self.assertIn('quota unknown',result.stderr)
        self.config['budget']['unknown_interactive']='block';self.save();marker.unlink()
        result=subprocess.run(command,capture_output=True,text=True)
        self.assertNotEqual(result.returncode,0);self.assertFalse(marker.exists())

    def test_unknown_interactive_still_enforces_concurrency_and_partial_reserve(self):
        self.quota(.1,limits=[])
        self.config['budget']['managed_concurrency_per_pool']=1
        with b.admission(self.config,'codex','managed',interactive=True):
            with self.assertRaisesRegex(ValueError,'concurrency'):
                with b.admission(self.config,'codex','managed',interactive=True):pass
        self.config['providers']=['codex','claude']
        self.config['routing']['account_pools']={'codex':'shared','claude':'shared'}
        self.quota(.9)
        with self.assertRaisesRegex(ValueError,'protected'):
            b.check(self.config,'claude',interactive=True)

    def test_quota_rpc_handles_batched_notifications_and_response(self):
        import codex_quota
        child=subprocess.Popen([sys.executable,'-c',
            'import sys,time;sys.stdin.readline();sys.stdout.write(\'{'+'"method":"notice"}\\n{"id":1,"result":{"ok":true}}\\n'+"\');sys.stdout.flush();time.sleep(10)"],
            stdin=subprocess.PIPE,stdout=subprocess.PIPE)
        try:self.assertEqual(codex_quota.RPC(child).request(1,'probe',timeout=2),{'ok':True})
        finally:child.terminate();child.wait();child.stdin.close();child.stdout.close()

    def test_quota_refresh_failure_does_not_publish_fresh_capacity(self):
        import codex_quota
        self.quota(.1,limits=[])
        path=self.base/'state/omarchy/agents/usage/codex.json';before=path.read_bytes()
        with patch.object(codex_quota,'query',side_effect=TimeoutError('fixture')):
            with self.assertRaises(TimeoutError):codex_quota.refresh()
        self.assertEqual(path.read_bytes(),before)
        with patch.object(codex_quota,'query',return_value=[{'percent':.37}]) as query:
            codex_quota.refresh();codex_quota.refresh();query.assert_called_once()
        self.assertEqual(json.loads(path.read_text())['limits'],[{'percent':.37}])

    def test_invalid_limits_rejected(self):
        for key,value in [('external_reserve_fraction',float('nan')),('experiment_attempts_24h',True),('experiment_reserve_fraction',.1)]:
            config=copy.deepcopy(self.config);config['budget'][key]=value
            with self.assertRaises(ValueError):b.settings(config)

if __name__=='__main__':unittest.main()
