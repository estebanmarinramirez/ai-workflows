    def test_difficulty_change_cancels_only_its_unlaunched_automatic_requests(self):
        self.config['routing']['manage_orchestrator'] = True
        self.save_config()
        self.reconcile()
        store = self.router().store
        state = store.load()
        lead = next(r for r in state['requests'].values() if r['slot'] == 'codex')
        lead['phase'] = 'ready'
        unrelated = dict(lead, id='other-task', routing=dict(lead['routing'], task=str(self.task.parent/'other')))
        manual = dict(lead, id='manual', source='manual')
        state['requests'].update({'other-task': unrelated, 'manual': manual})
        store.save(state)
        result = self.cli('difficulty', '--task', str(self.task), '--difficulty', 'complex')
        self.assertEqual(result.returncode, 0, result.stderr)
        after = store.load()
        for key, row in after['requests'].items():
            self.assertEqual(row['phase'], 'ready' if key in ('manual','other-task') else 'cancelled')
        self.assertEqual(after['requests']['manual'], manual)
        self.assertEqual(after['requests']['other-task'], unrelated)
        # Remove unrelated fixture requests to inspect the new lead choice.
        del after['requests']['manual'], after['requests']['other-task']
        store.save(after)
        self.reconcile()
        new = next(r for r in store.load()['requests'].values() if r['slot']=='codex' and r['phase']=='requested')
        self.assertNotEqual(new['target']['model'], 'gpt-6-luna')
        self.assertEqual(new['target']['effort'], 'xhigh')
        self.assertEqual(new['routing']['difficulty'], 'complex')
        self.assertEqual(new['routing']['task_revision'], 1)

