    def test_selective_reviewer_activation_preserves_deferred_verification(self):
        self.config['budget']['enabled']=True;self.config['routing']['mode']='automatic';self.save_config()
        self.quota('grok',.2,limits=[])
        self.state.update(lead='claude',status='active',transitions=[],template_id='docs')
        for role,row in self.state['roles'].items():
            row['state']='completed' if role=='claude' else 'deferred'
            row['status_json']=str(self.task/(role+'.status.json'))
            atomic(Path(row['status_json']),dict(role=role,state=row['state'],commits=['abc'] if role=='claude' else []))
        self.save_task()
        tmux=self.base/'bin/tmux'
        tmux.write_text('#!/bin/sh\ncase "$1" in\nlist-sessions) printf "s-codex\\tcodex\\tw:set\\ns-grok\\tgrok\\tw:set\\n";;\nlist-panes) echo %1;;\nesac\n')
        tmux.write_text(tmux.read_text().replace('list-panes) echo %1;;','list-panes) echo %1;;\ncapture-pane) printf "› Ask Codex to do anything\\n❯\\n";;'))
        tmux.chmod(0o755)
        active=self.base/'bin/agent-workspaces-pane-active';active.write_text('#!/bin/sh\nexit 0\n');active.chmod(0o755)
        def activate(*args):
            return subprocess.run([str(ROOT/'bin/agent-workspaces'),'activate-reviewers',str(self.task),*args],capture_output=True,text=True)
        denied=activate('--roles','codex','grok');self.assertNotEqual(denied.returncode,0);self.assertIn('grok',denied.stderr)
        for args in (('--roles','claude'),('--roles','codex','codex'),('--roles','missing')):
            self.assertNotEqual(activate(*args).returncode,0)
        idle_script=tmux.read_text()
        tmux.write_text(idle_script.replace('Ask Codex to do anything','draft in progress'))
        self.assertEqual(activate().returncode,0)
        self.assertEqual(json.loads((self.task/'codex.status.json').read_text())['state'],'deferred')
        tmux.write_text(idle_script)
        other=self.root/'.coordination/other/state.json'
        atomic(other,dict(status='active',roles={'codex':{'state':'in_progress'}}))
        self.assertEqual(activate().returncode,0)
        self.assertEqual(json.loads((self.task/'codex.status.json').read_text())['state'],'deferred')
        other.unlink()
        processes=[subprocess.Popen([str(ROOT/'bin/agent-workspaces'),'activate-reviewers',str(self.task)],stdout=subprocess.PIPE,stderr=subprocess.PIPE,text=True) for _ in range(2)]
        outputs=[process.communicate(timeout=15) for process in processes]
        self.assertTrue(all(process.returncode==0 for process in processes),outputs)
        self.assertEqual(sum('Activated reviewers: codex' in out for out,err in outputs),1)
        state=json.loads((self.task/'state.json').read_text())
        self.assertEqual(state['roles']['codex']['state'],'dispatched')
        self.assertEqual(state['roles']['grok']['state'],'deferred')
        self.assertNotEqual(activate('--roles','codex').returncode,0)
        before=json.loads((self.task/'state.json').read_text());before.pop('updated_at',None)
        self.assertEqual(activate().returncode,0)
        after=json.loads((self.task/'state.json').read_text());after.pop('updated_at',None)
        self.assertEqual(after,before)
        self.assertIn('grok',state['review_activation']['deferred'])
        # Completing Codex does not silently waive Grok's verification.
        atomic(Path(self.state['roles']['codex']['status_json']),dict(role='codex',state='completed',commits=[]))
        subprocess.run([str(ROOT/'bin/agent-workspaces'),'refresh',str(self.task)],check=True,capture_output=True)
        self.assertEqual(json.loads((self.task/'state.json').read_text())['status'],'awaiting_review')
        self.quota('grok',.2)
        result=subprocess.run([str(ROOT/'bin/agent-workspaces'),'reconcile-reviewers','w:set'],capture_output=True,text=True)
        self.assertEqual(result.returncode,0,result.stderr)
        self.assertEqual(json.loads((self.task/'grok.status.json').read_text())['state'],'dispatched')

