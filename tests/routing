    def test_incomplete_shared_pool_retains_known_spending_constraints(self):
        self.config['routing']['account_pools'] = {'codex': 'shared', 'grok': 'shared'}
        # Aggregation must not depend on whether the unknown member comes first.
        for providers in (['codex', 'grok', 'claude'], ['grok', 'codex', 'claude']):
            self.config['providers'] = providers
            self.save_config()
            self.quota('grok', .1, ready=False)
            for used in (1, .9, .2):
                with self.subTest(providers=providers, used=used):
                    self.quota('codex', used)
                    router = self.router()
                    pool = router.pools['shared']
                    self.assertEqual(pool['remaining'], round(1-used, 6))
                    self.assertTrue(pool['incomplete'])
                    self.assertEqual(pool['state'], 'exhausted' if used == 1 else 'unknown')
                    self.assertEqual(bool(router.guard(['codex'], str(self.task))), used >= .9)
                    self.assertEqual(bool(router.guard(['codex'], review=True)), used == 1)
                    self.assertEqual(bool(router.guard(['grok'], review=True)), used == 1)
                    self.assertEqual(bool(router.guard(['codex'])), used >= .9)
                    # Partial headroom is never an eligible automatic destination.
                    self.quota('claude', 1)
                    row = next(r for r in self.router().plan()['decisions'] if r['slot'] == 'claude')
                    self.assertNotEqual(row['action'], 'handover')
                    self.quota('claude', .2)
            self.quota('codex', .1, ready=False)
            self.assertIsNone(self.router().pools['shared']['remaining'])
            self.assertFalse(self.router().guard(['codex']))

