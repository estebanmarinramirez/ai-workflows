    def save_config(self): atomic(self.config_root/'config.json', self.config)
    def save_task(self): atomic(self.task/'state.json', self.state)
    def quota(self, provider, used, **changes):
        value = dict(schemaVersion=1, id=provider, ready=True, updatedAt=self.now.isoformat(),
                     limits=[dict(percent=used, resetsAt=(self.now+timedelta(hours=4)).isoformat())])
        value.update(changes)
        atomic(self.usage/f'{provider}.json', value)
    def router(self): return Router(self.root, str(ROOT/'bin/agent-workspaces'), self.now)
    def decision(self, slot='codex'): return next(r for r in self.router().plan()['decisions'] if r['slot']==slot)
    def cli(self, *args):
        return subprocess.run([str(ROOT/'bin/agent-workspaces'), 'routing', 'w:set', *args], text=True, capture_output=True)
    def reconcile(self):
        def session(store, slot): return f's-{slot}', provider_for_slot(store.root, slot, self.state, self.config)
        with patch.object(assignments.Assignments, 'sessions', session), patch.object(assignments, 'run', return_value='saved'):
            return self.router().reconcile()

    def test_new_task_waits_for_configuration_acknowledgement(self):
        self.config['routing']['effort_mode']='balanced';self.save_config()
        self.state['status']='awaiting_configuration';self.state['routing']['difficulty']='standard';self.save_task()
        cheap=dict(provider='codex',model='gpt-6-luna',effort='low',source='routing')
        atomic(self.root/'.coordination/agents.json',{'active':{'codex':cheap},'requests':{}})
        with patch.object(assignments.Assignments,'sessions',return_value=('s-codex','codex')),patch.object(assignments,'run',return_value='saved'):
            router=self.router();self.assertTrue(router.readiness(self.task,['codex']))
            state=router.store.load();request=next(r for r in state['requests'].values() if r['slot']=='codex')
            self.assertEqual(request['target']['model'],'gpt-6.1-sol')
            self.assertEqual(request['target']['effort'],'medium')
            request['phase']='active';request['accepted_at']=self.now.isoformat()
            state['active']['codex']=dict(request['target'],source='routing');router.store.save(state)
            self.assertEqual(router.readiness(self.task,['codex']),[])

