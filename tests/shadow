import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch
sys.dont_write_bytecode = True
ROOT=Path(__file__).resolve().parents[1]
sys.path.insert(0,str(ROOT/'lib'))
import benchmark as b
import shadow as s


class Shadow(unittest.TestCase):
    def setUp(self):
        self.manifest={'data_kind':'real','shadow':{'enabled':True,'min_tasks':2},
            'hashes':{'adapter':'a','verifier':'v'},
            'tasks':[{'id':f'd{i}','split':'development','family':'repair','instance_id':f'issue-{i}'} for i in range(3)]+
                    [{'id':'h','split':'heldout','family':'repair','instance_id':'test-issue'}],
            'configurations':[{'id':name,'topology':'solo','roles':{'coordinator':{'provider':'fixture','model':'m','effort':'high','model_version':'v1'},
                                  'implementer':{'provider':'fixture','model':name,'effort':'high','model_version':'v1'}}} for name in ('a','b')]}
        self.history=[]
        for i in range(3):
            for name in ('a','b'):
                accepted=name=='a'
                outcome={'accepted':accepted,'verified':accepted,'failure':None if accepted else 'verification_failed','cost_usd':.01,'wall_seconds':2}
                self.history.append({'id':f'{name}-{i}','task':f'd{i}','configuration':name,'repetition':0,'status':'finished','result':json.dumps(outcome)})

    def prediction(self, task=None):
        return s.predict(self.manifest,self.history,task or self.manifest['tasks'][-1],'b',99)

    def test_posterior_matches_conjugate_update_and_does_not_change_actual_action(self):
        result=self.prediction()
        a,b_=result['candidates']
        self.assertEqual((a['end_to_end']['alpha'],a['end_to_end']['beta']),(4,1))
        self.assertEqual(a['end_to_end']['mean'],.8)
        self.assertEqual(b_['end_to_end']['mean'],.2)
        self.assertEqual(result['recommended_configuration'],'a')
        self.assertEqual(result['actual_configuration'],'b')
        self.assertGreater(a['end_to_end']['stddev'],0)

    def test_execution_failures_never_reduce_capability_posterior(self):
        for row in self.history:
            row['result']=json.dumps({'accepted':False,'failure':'harness_error','cost_usd':0,'wall_seconds':2})
        result=self.prediction()
        for candidate in result['candidates']:
            self.assertEqual(candidate['capability']['observations'],0)
            self.assertEqual(candidate['capability']['mean'],.5)
            self.assertEqual(candidate['end_to_end']['mean'],.2)
            self.assertEqual(candidate['excluded_capability_outcomes'],3)

    def test_synthetic_and_demo_cannot_train_or_recommend(self):
        self.manifest['data_kind']='synthetic'
        result=self.prediction()
        self.assertEqual(result['abstention_reason'],'synthetic_or_demo_data')
        self.assertEqual(result['training_trials'],[])
        self.manifest['data_kind']='real'
        self.manifest['configurations'][0]['roles']['coordinator']['provider']='demo'
        self.assertEqual(self.prediction()['training_trials'],[])

    def test_repetitions_same_instance_other_families_and_heldout_are_excluded(self):
        self.history += [dict(self.history[0],id='repeat',repetition=1),
                         dict(self.history[0],id='test-leak',task='h')]
        result=self.prediction(self.manifest['tasks'][0])
        self.assertNotIn('repeat',result['training_trials'])
        self.assertNotIn('test-leak',result['training_trials'])
        self.assertNotIn('a-0',result['training_trials'])
        self.assertEqual(len(result['training_trials']),4)
        self.manifest['tasks'][1]['family']='different'
        self.assertEqual(self.prediction(self.manifest['tasks'][0])['abstention_reason'],'insufficient_distinct_development_tasks')

    def test_unknown_cost_abstention_and_explicit_zero_cost_weight(self):
        result=json.loads(self.history[0]['result']); result['cost_usd']=None
        self.history[0]['result']=json.dumps(result)
        self.assertEqual(self.prediction()['abstention_reason'],'unknown_cost_or_latency')
        self.manifest['shadow']['cost_weight']=0
        result=self.prediction()
        self.assertEqual(result['recommended_configuration'],'a')
        self.assertIsNone(result['candidates'][0]['mean_cost_usd'])

    def test_eligibility_quality_floor_and_version_identity(self):
        original=s.fingerprint(self.manifest,self.manifest['configurations'][0])
        self.manifest['configurations'][0]['roles']['implementer']['model_version']='v2'
        self.assertNotEqual(original,s.fingerprint(self.manifest,self.manifest['configurations'][0]))
        self.manifest['configurations'][0]['shadow_eligible']=False
        self.assertEqual(self.prediction()['recommended_configuration'],'b')
        self.manifest['shadow']['minimum_success_mean']=.9
        self.assertEqual(self.prediction()['abstention_reason'],'success_mean_floor_not_met')

    def test_calibration_scores_saved_forecast_not_refitted_history(self):
        result=self.prediction(); result.update(split='heldout',task_id='h')
        events=[{'id':1,'trial':'t','kind':'shadow_prediction','payload':json.dumps(result)},
                {'id':2,'trial':'t','kind':'finished','payload':json.dumps({'accepted':True,'failure':None})}]
        score=s.evaluate(self.manifest,events,'heldout')
        self.assertAlmostEqual(score['brier_score'],.64)
        self.assertEqual(score['scored_trials'],1)
        self.assertEqual(s.evaluate(self.manifest,events,'development')['scored_trials'],0)
        result['synthetic']=True; events[0]['payload']=json.dumps(result)
        self.assertIsNone(s.evaluate(self.manifest,events,'heldout')['brier_score'])

    def test_duplicate_instance_and_bad_policy_rejected(self):
        self.manifest['tasks'][-1]['instance_id']='issue-0'
        with self.assertRaises(ValueError): s.policy(self.manifest)
        self.manifest['tasks'][-1]['instance_id']='unique'
        self.manifest['shadow']['cost_weight']=float('nan')
        with self.assertRaises(ValueError): s.policy(self.manifest)


class Integration(unittest.TestCase):
    def setUp(self):
        temp=tempfile.TemporaryDirectory(); self.addCleanup(temp.cleanup)
        self.base=Path(temp.name); self.source=self.base/'source'; self.root=self.base/'experiment'
        subprocess.run([sys.executable,str(ROOT/'examples/benchmark/create-demo.py'),str(self.source)],check=True,capture_output=True)
        b.initialize(self.source/'manifest.json',self.root)

    def test_prediction_is_committed_before_adapter_and_is_append_only(self):
        execute=b.execute
        def inspect(*args):
            db=b.database(self.root)
            events=[dict(r) for r in db.execute('SELECT * FROM events ORDER BY id')]; db.close()
            self.assertEqual([r['kind'] for r in events],['shadow_prediction','started'])
            self.assertIsNone(json.loads(events[0]['payload'])['recommended_configuration'])
            return execute(*args)
        with patch.object(b,'execute',side_effect=inspect): outcome=b.run_trial(self.root)
        self.assertTrue(outcome['accepted'])
        db=b.database(self.root)
        events=[dict(r) for r in db.execute('SELECT * FROM events ORDER BY id')]; db.close()
        self.assertEqual(events[-1]['kind'],'finished')
        self.assertEqual(s.evaluate(b.load(self.root),events,'development')['excluded_synthetic_trials'],1)

    def test_heldout_requires_development_completion_without_claiming_a_trial(self):
        with self.assertRaisesRegex(ValueError,'Finish all development'):
            b.run_trial(self.root,split='heldout')
        db=b.database(self.root)
        self.assertEqual(db.execute('SELECT count(*) FROM events').fetchone()[0],0); db.close()

    def test_version_receipt_mismatch_and_verifier_infrastructure_attribution(self):
        config=b.load(self.root)['configurations'][0]
        path=self.base/'usage.json'
        value={'roles':{k:dict(v,model_version='wrong') for k,v in config['roles'].items()}}
        b.write(path,value)
        with self.assertRaisesRegex(ValueError,'version'): b.usage(path,config)
        with patch.object(b,'execute',side_effect=[(0,False),(2,False)]):
            result=b.run_trial(self.root)
        self.assertEqual(result['failure_category'],'verification_infrastructure')
        self.assertIsNone(result['capability_label'])
        self.assertIsNone(result['verified'])


unittest.main()
