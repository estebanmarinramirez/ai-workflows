    def test_routing_and_guard_agree_with_admission(self):
        for provider in self.config['providers']: self.native(provider, 1.0)
        def router(): return Router(self.root, str(ROOT / 'bin/agent-workspaces'), self.now)
        def decision(): return next(r for r in router().plan()['decisions'] if r['slot'] == 'codex')
        self.assertEqual(decision()['action'], 'wait')
        self.assertTrue(router().guard(['codex'], str(self.task)))
        self.credit()
        row = decision()
        self.assertEqual(row['action'], 'keep'); self.assertEqual([c['allowance'] for c in row['candidates']], ['credits'])
        self.assertEqual(router().guard(['codex'], str(self.task)), [])
        self.assertTrue(router().guard(['claude'], str(self.task)))  # codex credits never fund another provider
        self.native('claude', .2)
        row = decision()
        self.assertEqual({c['target']['provider']: c['allowance'] for c in row['candidates']}, {'codex': 'credits', 'claude': 'subscription'})
        self.assertEqual(max(row['candidates'], key=lambda c: c['score'])['target']['provider'], 'claude')

    def test_configured_credit_policy_preserves_subscription_ranking(self):
        self.config['budget']['credit_backed_managed_providers'] = ['codex']
        self.config['routing']['switch_improvement'] = 0
        self.save()
        self.native('codex', .02)
        self.native('claude', .05)
        self.native('grok', 1.0)
        row = next(r for r in self.router().plan()['decisions'] if r['slot'] == 'codex')
        self.assertEqual((row['action'], row['target']['provider']), ('keep', 'codex'))
        candidates = {c['target']['provider']: c for c in row['candidates']}
        self.assertEqual(candidates['codex']['allowance'], 'subscription')
        self.assertEqual(candidates['claude']['allowance'], 'subscription')
        self.assertGreater(candidates['codex']['score'], candidates['claude']['score'])
        # Actual no-collector fallback retains low priority below subscription headroom.
        self.native('codex', 1.0)
        row = next(r for r in self.router().plan()['decisions'] if r['slot'] == 'codex')
        self.assertEqual((row['action'], row['target']['provider']), ('handover', 'claude'))
        candidates = {c['target']['provider']: c for c in row['candidates']}
        self.assertEqual(candidates['codex']['allowance'], 'configured_credits')
        self.assertLessEqual(candidates['codex']['score'], 1e-6)
        self.assertGreater(candidates['claude']['score'], candidates['codex']['score'])

