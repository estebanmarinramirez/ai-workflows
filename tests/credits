    def test_codex_collector_contract_is_sanitized_and_validates_variants(self):
        now = datetime.now(timezone.utc)
        reset = int((now + timedelta(days=1)).timestamp())
        result = {'accountId': 'acct-secret', 'ordinaryUsageAllowed': True,
                  'rateLimits': {'primary': {'usedPercent': 100, 'resetsAt': reset}, 'spendControlReached': False,
                                 'credits': {'hasCredits': True, 'unlimited': False, 'balance': BALANCE}, 'planType': 'x'}}
        windows, observation = codex_quota.parse(result, now)
        self.assertEqual([w['percent'] for w in windows], [1.0])
        self.assertEqual((observation['balance'], observation['unit'], observation['source']), (BALANCE, 'credits', 'codex-app-server'))
        self.assertNotIn('acct-secret', json.dumps(observation)); self.assertNotIn('planType', observation)
        normalized = capacity.normalize_credits(observation, now, 300)
        self.assertEqual((normalized['state'], normalized['usable']), ('available', True))
        denied, _ = codex_quota.parse(dict(result, ordinaryUsageAllowed=False), now)
        self.assertEqual(denied[-1], dict(label='account restriction', percent=1))
        _, capped = codex_quota.parse(json.loads(json.dumps(result).replace('"spendControlReached": false', '"spendControlReached": true')), now)
        self.assertEqual(capacity.normalize_credits(capped, now, 300)['state'], 'denied')
        _, nocredits = codex_quota.parse(dict(result, rateLimits={k: v for k, v in result['rateLimits'].items() if k != 'credits'}), now)
        self.assertEqual(capacity.normalize_credits(nocredits, now, 300)['state'], 'unknown')
        for bad in ({'rateLimits': None}, {'rateLimits': {}}, {'rateLimits': {'primary': {'usedPercent': True, 'resetsAt': reset}}},
                    {'rateLimits': {'primary': {'usedPercent': 101, 'resetsAt': reset}}}, {'rateLimits': {'primary': {'usedPercent': 5, 'resetsAt': 1}}}):
            with self.subTest(bad), self.assertRaises((ValueError, KeyError, TypeError)): codex_quota.parse(bad, now)

    def test_collector_refreshes_credits_when_native_limits_are_fresh(self):
        self.native('codex', .2)
        credit = dict(provider='codex', source='codex-app-server', unit='credits', observedAt=self.now.isoformat(), hasCredits=True, unlimited=False,
                      balance='1', ordinaryUsageAllowed=True, spendControlReached=False)
        before = (self.usage / 'codex.json').read_bytes()
        with patch.object(codex_quota, 'query', return_value=([dict(percent=.9)], credit)) as query:
            codex_quota.refresh()
        query.assert_called_once()
        self.assertEqual(json.loads((self.sidecar / 'codex.json').read_text())['balance'], '1')
        self.assertEqual((self.usage / 'codex.json').read_bytes(), before)  # native subscription record untouched
        self.assertEqual(oct((self.sidecar / 'codex.json').stat().st_mode & 0o777), '0o600')

    def test_balance_churn_does_not_wake_but_eligibility_change_does(self):
        script = f'source {ROOT}/lib/core.sh; aw_actionable_signature "$1"'
        signature = lambda: subprocess.check_output(['bash', '-c', script, 'x', str(self.root)], text=True).strip()
        self.credit(balance='10'); first = signature()
        for balance in ('9.5', '8', '1000'):
            self.credit(balance=balance, observedAt=(self.now + timedelta(minutes=1)).isoformat())
            self.native('codex', .5)
            self.assertEqual(signature(), first, balance)
        state = json.loads((self.task / 'state.json').read_text())
        state.setdefault('review_activation', {})['deferred'] = {'grok': 'budget requires fresh authoritative quota'}
        atomic(self.task / 'state.json', state)
        self.assertNotEqual(signature(), first)


