    def save(self): atomic(self.base / 'config/agent-workspaces/config.json', self.config)

    def native(self, provider, used, **changes):
        value = dict(schemaVersion=1, id=provider, ready=True, updatedAt=self.now.isoformat(), limits=[dict(percent=used, resetsAt=(self.now + timedelta(hours=4)).isoformat())])
        value.update(changes)
        atomic(self.usage / f'{provider}.json', value)

    def credit(self, provider='codex', **changes):
        value = dict(provider=provider, source='fixture', unit='credits', observedAt=self.now.isoformat(), hasCredits=True, unlimited=False,
                     balance=BALANCE, ordinaryUsageAllowed=True, spendControlReached=False)
        value.update(changes)
        value = {k: v for k, v in value.items() if v is not ...}
        atomic(self.sidecar / f'{provider}.json', value)

    def pool(self, provider='codex'):
        return capacity.capacities(self.config, self.usage, self.now)[1][capacity.pool_id(provider, self.config['routing'])]

    def allowed(self, provider='codex', purpose='managed'):
        try: b.check(self.config, provider, purpose); return True
        except ValueError: return False

    def test_installed_credit_policy_defers_to_observed_credit_constraints(self):
        self.config['budget']['credit_backed_managed_providers'] = ['codex']
        self.save()
        self.native('codex', 1.0)
        # Preserve explicit ordinary authority when the provider has no credit collector.
        self.assertTrue(self.allowed())
        self.assertFalse(self.router().guard(['codex'], self.task))
        for change in ({'ordinaryUsageAllowed': False}, {'spendControlReached': True},
                       {'balance': '0'}, {'balance': 'NaN'},
                       {'observedAt': (self.now-timedelta(hours=1)).isoformat()}):
            with self.subTest(change=change):
                self.credit(**change)
                self.assertFalse(self.allowed())
                router = self.router()
                self.assertTrue(router.guard(['codex'], self.task))
                for row in router.plan()['decisions']:
                    self.assertNotIn('codex', [c['target']['provider'] for c in row.get('candidates', [])])
                    self.assertFalse(row['action'] == 'handover' and row['target']['provider'] == 'codex')
        # A malformed sidecar also counts as observed evidence, never as a missing collector.
        (self.sidecar / 'codex.json').write_text('{')
        self.assertFalse(self.allowed())
        self.assertTrue(self.router().guard(['codex'], self.task))
        # Unknown aliases cannot hide another alias's observed constraints.
        self.config['routing']['account_pools'] = {'codex': 'shared', 'claude': 'shared'}
        self.save()
        self.credit(balance='0')
        self.assertFalse(self.allowed())
        self.assertTrue(self.router().guard(['codex'], self.task))
        self.config['routing']['account_pools'] = {}
        self.save()
        self.credit()
        self.assertTrue(self.allowed())
        self.assertFalse(self.router().guard(['codex'], self.task))
        self.config['budget']['credit_minimum'] = {'codex': 30000}
        self.save()
        self.assertFalse(self.allowed())
        self.assertTrue(self.router().guard(['codex'], self.task))
        for purpose in ('experiment', 'boost'):
            self.assertFalse(self.allowed(purpose=purpose))

    def test_exhausted_subscription_with_confirmed_credits_allows_only_ordinary_work(self):
        self.native('codex', 1.0); self.credit()
        pool = self.pool()
        self.assertEqual((pool['state'], pool['remaining'], pool['used']), ('exhausted', 0, 1.0))
        self.assertEqual((pool['credits']['state'], pool['credits']['balance'], pool['credits']['unit']), ('available', BALANCE, 'credits'))
        self.assertEqual(capacity.ordinary_allowance(pool, .05), (True, 'credits'))
        self.assertTrue(self.allowed())
        with b.admission(self.config, 'codex', 'managed'): pass
        for purpose in ('experiment', 'boost'): self.assertFalse(self.allowed(purpose=purpose), purpose)
        self.assertNotIn('percent', json.dumps(pool['credits']))

