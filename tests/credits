    def test_newer_authoritative_limits_are_not_hidden_behind_a_fresh_native_cache(self):
        self.native('codex', .2, updatedAt=(self.now - timedelta(seconds=60)).isoformat())
        reset = (self.now + timedelta(hours=4)).isoformat()
        credit = dict(provider='codex', source='codex-app-server', unit='credits', observedAt=self.now.isoformat(), hasCredits=True, unlimited=False,
                      balance='100', ordinaryUsageAllowed=True, spendControlReached=False)
        with patch.object(codex_quota, 'query', return_value=([dict(percent=1.0, resetsAt=reset)], credit)):
            codex_quota.refresh()
        pool = self.pool()
        self.assertEqual((pool['used'], pool['state']), (1.0, 'exhausted'))
        self.assertTrue(self.allowed())
        for purpose in ('experiment', 'boost'): self.assertFalse(self.allowed(purpose=purpose), purpose)
        # a returned restriction takes precedence over permissive windows
        restricted = [dict(percent=.1, resetsAt=reset), dict(label='account restriction', percent=1)]
        self.native('codex', .2)
        with patch.object(codex_quota, 'query', return_value=(restricted, dict(credit, ordinaryUsageAllowed=False))):
            codex_quota.refresh()
        self.assertEqual(self.pool()['used'], 1.0); self.assertFalse(self.allowed())
        # an older observation never overrides a newer native one; an exact tie keeps the more constrained
        old = self.now - timedelta(seconds=120)
        self.native('codex', .2)
        with patch.object(codex_quota, 'query', return_value=([dict(percent=1.0, resetsAt=reset)], dict(credit, observedAt=old.isoformat()))):
            codex_quota.refresh()
        self.assertEqual(self.pool()['used'], .2)
        atomic(self.sidecar / 'codex.json', dict(credit, observedAt=self.now.isoformat(), limits=[dict(percent=1.0, resetsAt=reset)]))
        self.assertEqual(self.pool()['used'], 1.0)

    def test_merged_alias_balance_is_checked_against_the_strictest_minimum_in_any_order_or_source(self):
        self.config['routing']['account_pools'] = {'codex': 'shared', 'claude': 'shared'}
        self.native('codex', 1.0); self.native('claude', 1.0)
        for first, second in (('codex', 'claude'), ('claude', 'codex')):
            self.config['providers'] = [first, second]
            with self.subTest(first):
                self.config['budget']['credit_minimum'] = {'codex': '50'}
                self.credit('codex', balance='100'); self.credit('claude', balance='1', source='another-source')
                self.assertEqual(self.pool()['credits']['balance'], '1')
                self.assertFalse(self.allowed('codex')); self.assertFalse(self.allowed('claude'))
                self.credit('claude', balance='60', source='another-source')
                self.assertTrue(self.allowed('codex')); self.assertTrue(self.allowed('claude'))
                self.config['budget']['credit_minimum'] = {'claude': '75', 'codex': '10'}
                self.assertFalse(self.allowed('codex'))  # the stricter alias minimum binds the shared balance
                self.credit('claude', balance='80', source='another-source'); self.assertTrue(self.allowed('codex'))
                self.credit('claude', balance='80', source='another-source', unit='USD')
                self.assertEqual(self.pool()['credits']['state'], 'unknown'); self.assertFalse(self.allowed('codex'))

    def test_unlimited_alias_does_not_launder_a_finite_alias_below_the_strictest_minimum(self):
        self.config['routing']['account_pools'] = {'codex': 'shared', 'claude': 'shared'}
        self.native('codex', 1.0); self.native('claude', 1.0)
        for first, second in (('codex', 'claude'), ('claude', 'codex')):
            with self.subTest(first):
                self.config['providers'] = [first, second]
                self.config['budget']['credit_minimum'] = {'codex': '50', 'claude': '0'}
                self.credit('codex', unlimited=True, balance=..., hasCredits=...); self.credit('claude', balance='1')
                self.assertEqual(self.pool()['credits']['state'], 'none')
                self.assertFalse(self.allowed('codex')); self.assertFalse(self.allowed('claude'))
                self.credit('claude', balance='51')
                self.assertTrue(self.allowed('codex')); self.assertTrue(self.allowed('claude'))
                self.config['budget']['credit_minimum'] = {'codex': '0', 'claude': '60'}  # strictest minimum may sit on the finite alias
                self.assertFalse(self.allowed('codex'))
                self.credit('claude', balance='61'); self.assertTrue(self.allowed('codex'))
                self.credit('claude', unlimited=True, balance=..., hasCredits=...)  # two unlimited aliases stay unlimited
                self.assertEqual(self.pool()['credits']['state'], 'unlimited'); self.assertTrue(self.allowed('claude'))
                self.config['budget']['credit_minimum'] = {}
                self.credit('claude', balance='1', unit='USD')  # mixed units never merge
                self.assertEqual(self.pool()['credits']['state'], 'unknown')
                self.credit('claude', balance='1', ordinaryUsageAllowed=False); self.assertFalse(self.allowed('codex'))

    def test_snapshot_account_text_matches_admission_without_money(self):
        def line():
            report = self.router().plan()
            return next(x for x in routing.display(report).splitlines() if 'Account codex:' in x)
        self.native('codex', 1.0)
        self.assertNotIn('paid', line())
        self.credit()
        text = line()
        self.assertIn('subscription exhausted, paid allowance available for ordinary work', text)
        self.assertNotIn(BALANCE, text); self.assertNotIn('24973', text)
        self.credit(spendControlReached=True); self.assertNotIn('paid allowance', line())
